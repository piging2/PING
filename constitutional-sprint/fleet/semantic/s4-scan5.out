=== Dockerfile.worker-runtime ===
FROM python:3-alpine

WORKDIR /app

# Copy worker runtime and kernel
COPY workers/ /app/workers/
COPY kernel/ /app/kernel/

# Worker runtime polls gateway via HTTP — no direct DB connections
ENV GATEWAY_URL=http://gateway:8080
ENV POLL_INTERVAL=5.0
ENV MAX_RETRIES=3
ENV WORKER_NAME=worker_runtime

CMD ["python3", "-u", "/app/workers/worker_runtime.py"]
