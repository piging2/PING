      - prod

  # ============================================
  # WORKER LAYER
  # ============================================

  # Digestion Worker - RSS/Article Processing
  digestion-worker:
    build:
      context: ./brainos/rss
      dockerfile: Dockerfile
    container_name: ping-digestion-worker
    restart: unless-stopped
    env_file:
      - ./brainos/rss/.env
    environment:
      OLLAMA_BASE_URL: http://ollama:11434
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-ping_runtime}
    volumes:
      - ./brainos/rss/knowledge:/app/knowledge
      - ./brainos/rss/knowledge.db:/app/knowledge.db
    networks:
      - ping_internal
    depends_on:
      - ollama
      - postgres
    profiles:
      - dev

  # Newsletter Worker - Yahoo Mail Processing
  newsletter-worker:
    build:
      context: ./brainos/newsletter
      dockerfile: Dockerfile
    container_name: ping-newsletter-worker
    restart: unless-stopped
    env_file:
      - ./brainos/newsletter/.env
    environment:
      OLLAMA_BASE_URL: http://ollama:11434
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-ping_runtime}
    volumes:
      - ./brainos/newsletter/knowledge:/app/knowledge
      - ./brainos/newsletter/newsletters.db:/app/newsletters.db
      - ./brainos/newsletter/digests:/app/digests
    networks:
      - ping_internal
    depends_on:
      - ollama
      - postgres
    profiles:
      - dev

  # Projection Worker - Vector Projection
  projection-worker:
    build:
      context: .
      dockerfile: Dockerfile.projection
    container_name: ping-projection-worker
    restart: unless-stopped
    env_file:
      - .env.base
    environment:
      QDRANT_URL: http://qdrant:6333
      QDRANT_API_KEY: ${QDRANT_API_KEY}
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-ping_runtime}
    networks:
      - ping_internal
    depends_on:
      - qdrant
      - postgres
    profiles:
      - dev

  # Witness Worker - Witness Computation
  witness-worker:
    build:
      context: .
      dockerfile: Dockerfile.witness
    container_name: ping-witness-worker
    restart: unless-stopped
    env_file:
      - .env.base
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-ping_runtime}
    networks:
      - ping_internal
    depends_on:
      - postgres
    profiles:
      - dev

  # Replay Worker - Event Replay
  replay-worker:
    build:
      context: .
      dockerfile: Dockerfile.replay
    container_name: ping-replay-worker
    restart: unless-stopped
    env_file:
      - .env.base
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-ping_runtime}
    networks:
      - ping_internal
    depends_on:
      - postgres
    profiles:
      - dev

  # Worker Runtime - Constitutional Pipeline Driver
  worker-runtime:
    build:
      context: .
      dockerfile: Dockerfile.worker-runtime
    container_name: ping-worker-runtime
    restart: unless-stopped
    env_file:
      - .env.base
    environment:
      GATEWAY_URL: http://gateway:8080
      POLL_INTERVAL: "5.0"
      MAX_RETRIES: "3"
      WORKER_NAME: worker_runtime
    networks:
      - ping_internal
    depends_on:
      gateway:
        condition: service_started
    profiles:
      - dev
      - prod

  # ============================================
  # UI LAYER
  # ============================================

