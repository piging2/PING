### (4) workflow triggers + jobs
===== constitutional_ci.yml =====
name: Constitutional CI
on:
  push:
  pull_request:
jobs:
    runs-on: ${{ matrix.os }}
        node-version: [18.x, 20.x]
    - name: Checkout code
    - name: Setup Node.js ${{ matrix.node-version }}
        node-version: ${{ matrix.node-version }}
    - name: Install dependencies
      run: npm ci
===== replay-integrity.yml =====
name: Replay Integrity
on:
  pull_request:
  push:
jobs:
    runs-on: ubuntu-latest
    - name: Checkout code
    - name: Setup Node.js
        node-version: '18'
    - name: Install dependencies
      run: npm ci
    - name: Run dependency validator
===== constitutional-pipeline.yml =====
name: Constitutional Pipeline
on:
  push:
  pull_request:
jobs:
    runs-on: ubuntu-latest
      - name: Checkout code
      - name: Setup Node.js
          node-version: '18'
      - name: Install dependencies
        run: npm ci
      - name: Verify Technology Manifest
===== constitutional-ops.yml =====
name: Constitutional Operations
on:
  push:
  pull_request:
jobs:
    runs-on: ubuntu-latest
          python-version: '3.11'
      - name: Validate mission graph
        run: python scripts/constitutional_query.py show VerifyReplay
===== freeze.yml =====
name: freeze
on:
  pull_request:
  push:
jobs:
    runs-on: ubuntu-latest
      - run: pnpm install
      - run: pnpm build
      - run: pnpm test
