### constitutional_ci.yml test steps
name: Constitutional CI
    - name: Checkout code
    - name: Setup Node.js ${{ matrix.node-version }}
    - name: Install dependencies
      run: npm ci
    - name: Run build
      run: npm run build
    - name: Run unit tests
      run: npm test
    - name: Checkout code
    - name: Setup Node.js
    - name: Install dependencies
      run: npm ci
    - name: Load golden corpus
      run: node test/replay_corpus_test.js
    - name: Verify all transcripts
      run: node test/verify_corpus.js
    - name: Generate certificates
      run: node test/generate_certificates.js
    - name: Compare with golden certificates
      run: node test/compare_certificates.js
    - name: Checkout code
    - name: Setup Node.js
    - name: Install dependencies
      run: npm ci
    - name: Run constitutional fuzzer
      run: node test/fuzz_test.js --iterations 1000
    - name: Verify deterministic hashes
      run: node test/verify_determinism.js
    - name: Checkout code
