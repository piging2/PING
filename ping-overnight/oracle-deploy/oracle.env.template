# PING Oracle deployment - environment variable template
# Variable NAMES ONLY. No values. Fill in from the secure store on the target host.
# Compose reads these from the .env file sitting next to docker-compose.oracle.yml
# (docker compose interpolation; defaults shown where the compose file defines them).

# --- Required: Postgres ---
POSTGRES_USER=            # default in compose: ping
POSTGRES_PASSWORD=        # REQUIRED, no default; interpolated into postgres, gateway, litellm
POSTGRES_DB=              # default in compose: crx_runtime

# --- Required for the litellm profile only ---
LITELLM_API_KEY=          # REQUIRED if starting with --profile litellm; used as LITELLM_MASTER_KEY

# --- Optional: tuning (compose defaults shown) ---
LOG_LEVEL=                # default in compose: INFO
OLLAMA_BASE_URL=          # default in compose: http://host.docker.internal:11434
                          # NOTE: no Ollama process/container exists on Oracle today;
                          # the gateway embedding component runs in fallback mode.
                          # Real embeddings need an Ollama host (ARM64 builds exist).

# --- Present in the on-box .env but NOT interpolated by the canonical compose ---
# (vestigial / available for future use; compose sets these as literals)
# NODE_ENV / POSTGRES_HOST / POSTGRES_PORT / QDRANT_HOST / QDRANT_PORT / QDRANT_URL
NODE_ENV=
POSTGRES_HOST=
POSTGRES_PORT=
QDRANT_HOST=
QDRANT_PORT=
QDRANT_URL=

# --- Retired: only the removed compose `scheduler` service used this ---
# SCHEDULER_POLL_MS
