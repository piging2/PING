   /**
+   * Reclaim due retries - P0-4 fix (2026-09-16).
+   *
+   * Moves `retry_pending` missions whose `retry_at` has elapsed back to
+   * `created` (AVAILABLE), clearing the stale claim/lease fields left by the
+   * failed attempt. This is the method `failWithRetry()`'s docstring has
+   * always referenced: without it, a retried mission could never be
+   * re-claimed (`assign()` only transitions from `created`) and could never
+   * complete (`complete()` only transitions from `running`) - so any mission
+   * that failed once and succeeded on retry was stuck in `retry_pending`
+   * forever and re-executed on every scheduler poll.
+   *
+   * Conditional and idempotent: only due `retry_pending` rows are touched.
+   * Safe to call on every scheduler poll.
+   *
+   * @returns {Promise<number>} count of reclaimed missions
+   */
+  async reclaimRetryPending() {
+    const result = await this._pool.query(
+      `UPDATE ping_missions
+       SET status = 'created', assigned_to = NULL, lease_until = NULL,
+           claimed_at = NULL, retry_at = NULL
+       WHERE status = 'retry_pending'
+         AND retry_at IS NOT NULL
+         AND retry_at <= NOW()
+       RETURNING mission_id`
+    );
+
+    const reclaimed = result.rowCount || 0;
+    if (reclaimed > 0) {
+      console.log(`[MissionRuntime] Reclaimed ${reclaimed} due retry_pending mission(s)`);
+      for (const row of result.rows) {
+        if (this._eventRuntime) {
+          await this._eventRuntime.emit('MISSION_RETRY_RECLAIMED', 'mission-runtime', { missionId: row.mission_id });
+        }
+      }
+    }
+
+    return reclaimed;
+  }
