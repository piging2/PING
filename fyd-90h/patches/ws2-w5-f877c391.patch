+/**
+ * W5 projection-reader seam: integration proof on the trackc line.
+ *
+ * Exercises the REAL integrated modules (src/fyd/data/projection-reader.ts,
+ * projection-verify.ts, file-dump-projection-reader.ts, default-reader.ts,
+ * ping-object-source.ts):
+ *  1. Determinism: identical history -> identical snapshotDigest and
+ *     canonicalBytes; dumpedAt is informational (excluded from identity).
+ *  2. Fail-closed: tampered graphDigest throws; missing snapshot throws.
+ *  3. Interface-bound: an in-memory stub reader drives getPingObjectGraph
+ *     (no filesystem touched).
+ *  4. Sync fail-closed: an async-only reader refuses sync reads.
+ *  5. Naming law: the seam modules never describe a projection with the
+ *     word "authority" (the JOURNAL is the authority).
+ *  6. Seam listing: listPingSiteIds goes through the registered reader.
+ */
+import { createHash } from "node:crypto";
+import { mkdtempSync, writeFileSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { canonicalize } from "@/lib/ping/ask-composer";
+import { FileDumpProjectionReader } from "@/fyd/data/file-dump-projection-reader";
+import {
+  setProjectionReader,
+  resetProjectionReader,
+  isSyncProjectionReader,
+  type ProjectionReader,
+  type ProjectionSnapshot,
+} from "@/fyd/data/projection-reader";
+import {
+  getPingObjectGraph,
+  getPingObjectGraphSync,
+  listPingSiteIds,
+  listPingSiteIdsSync,
+} from "@/fyd/data/ping-object-source";
+
+const SITE = "seam-proof-site";
+
+function makeDoc(siteId: string, dumpedAt: string): Record<string, unknown> {
+  const graph = {
+    objects: [
+      {
+        id: "obj-1",
+        schema: "business",
+        visibility: "public",
+        title: "Seam Shop",
+        provenance: { kind: "procedural-fixture", ref: "fixture:seam" },
+      },
+    ],
+    relationships: [],
+  };
+  const graphDigest = createHash("sha256")
+    .update(canonicalize(graph), "utf8")
+    .digest("hex");
+  return {
+    meta: {
+      siteId,
+      dumpedAt,
+      dumperVersion: "1.2.1",
+      baseDigest: "b".repeat(64),
+      fixtureFileDigest: "f".repeat(64),
+      fixtureHeader: "h",
+      overlayEventIds: [],
+      graphDigest,
+      generatedAt: "2026-09-29T00:00:00Z",
+    },
+    graph,
+  };
+}
+
+function writeSite(dir: string, siteId: string, dumpedAt: string): string {
+  const path = join(dir, siteId + ".json");
+  writeFileSync(path, JSON.stringify(makeDoc(siteId, dumpedAt)));
+  return path;
+}
+
+afterEach(() => {
+  resetProjectionReader();
+  delete process.env.FYD_PROJECTION_DIR;
+});
+
+test("determinism: same history, two reads -> identical identity", async () => {
+  const d1 = mkdtempSync(join(tmpdir(), "w5d1-"));
+  const d2 = mkdtempSync(join(tmpdir(), "w5d2-"));
+  writeSite(d1, SITE, "2026-09-29T10:00:00Z");
+  // dumpedAt differs: informational only, excluded from snapshot identity.
+  writeSite(d2, SITE, "2026-09-29T11:00:00Z");
+  const reader = new FileDumpProjectionReader();
+  process.env.FYD_PROJECTION_DIR = d1;
+  const s1 = await reader.readSnapshot(SITE);
+  process.env.FYD_PROJECTION_DIR = d2;
+  const s2 = await reader.readSnapshot(SITE);
+  expect(s1.snapshotDigest).toBe(s2.snapshotDigest);
+  expect(s1.sourceDigest).toBe(s2.sourceDigest);
+  expect(s1.canonicalBytes).toBe(s2.canonicalBytes);
+  expect(s1.snapshotDigest).toBe(
+    createHash("sha256").update(s1.canonicalBytes, "utf8").digest("hex"),
+  );
+});
+
+test("fail-closed: tampered graphDigest throws; missing snapshot throws", async () => {
+  const d = mkdtempSync(join(tmpdir(), "w5f-"));
+  const path = writeSite(d, SITE, "2026-09-29T10:00:00Z");
+  const doc = JSON.parse(readFileSync(path, "utf8")) as {
+    meta: { graphDigest: string };
+  };
+  doc.meta.graphDigest = "0".repeat(64);
+  writeFileSync(path, JSON.stringify(doc));
+  process.env.FYD_PROJECTION_DIR = d;
+  const reader = new FileDumpProjectionReader();
+  await expect(reader.readSnapshot(SITE)).rejects.toThrow(/graphDigest mismatch/);
+  await expect(reader.readSnapshot("no-such-site")).rejects.toThrow(
+    /no snapshot/,
+  );
+});
+
+test("interface-bound: stub reader drives getPingObjectGraph, no fs touched", async () => {
+  const stubSnapshot: ProjectionSnapshot = {
+    siteId: SITE,
+    snapshotDigest: "stubdigest",
+    sourceDigest: "stubsource",
+    canonicalBytes: "{}",
+    dumpedAt: "2026-09-29T10:00:00Z",
+    graph: {
+      objects: [
+        {
+          id: "obj-9",
+          schema: "business",
+          visibility: "public",
+          title: "Stub Shop",
+          provenance: { kind: "procedural-fixture", ref: "fixture:stub" },
+        },
+      ],
+      relationships: [],
+    } as unknown as ProjectionSnapshot["graph"],
+    meta: {
+      siteId: SITE,
+      dumpedAt: "2026-09-29T10:00:00Z",
+      dumperVersion: "stub",
+      baseDigest: "b",
+      fixtureFileDigest: "f",
+      fixtureHeader: "h",
+      overlayEventIds: [],
+      graphDigest: "g",
+      generatedAt: "2026-09-29T10:00:00Z",
+    },
+    presentationIntent: null,
+    fieldVisibility: null,
+  };
+  const stubReader: ProjectionReader = {
+    kind: "remote",
+    readSnapshot: async (id: string) => {
+      if (id !== SITE) throw new Error("stub: unknown site");
+      return stubSnapshot;
+    },
+    listSiteIds: async () => [SITE],
+    regenerate: async () => {
+      throw new Error("stub: RegenerateUnsupported");
+    },
+  };
+  setProjectionReader(stubReader);
+  expect(isSyncProjectionReader(stubReader)).toBe(false);
+  // FYD_PROJECTION_DIR points nowhere: the stub must not touch the fs.
+  process.env.FYD_PROJECTION_DIR = join(tmpdir(), "w5-no-such-dir-xyz");
+  const proj = await getPingObjectGraph(SITE);
+  expect(proj.graph.objects[0]!.title).toBe("Stub Shop");
+  expect(proj.meta.dumperVersion).toBe("stub");
+  expect(() => getPingObjectGraphSync(SITE)).toThrow(/async contract only/);
+  expect(await listPingSiteIds()).toEqual([SITE]);
+});
+
+test("naming law: no 'projection authority' in the seam modules", () => {
+  const root = join(__dirname, "..");
+  for (const f of [
+    "projection-reader.ts",
+    "projection-verify.ts",
+    "file-dump-projection-reader.ts",
+    "default-reader.ts",
+    "ping-object-source.ts",
+  ]) {
+    const srcText = readFileSync(join(root, f), "utf8");
+    expect(srcText).not.toMatch(/projection authority/i);
+  }
+});
+
+test("seam listing: file-dump reader lists fixture sites", async () => {
+  const d = mkdtempSync(join(tmpdir(), "w5l-"));
+  writeSite(d, SITE, "2026-09-29T10:00:00Z");
+  process.env.FYD_PROJECTION_DIR = d;
+  expect(await listPingSiteIds()).toEqual([SITE]);
+  expect(listPingSiteIdsSync()).toEqual([SITE]);
+});
