index 00000000..a9498114
--- /dev/null
+++ b/src/fyd/proceduralize/dependency-index.ts
@@ -0,0 +1,159 @@
+/**
+ * DependencyIndex: answers exactly one question —
+ * "which generated site parts depend on this object?"
+ *
+ * Derived state, owned by the generator lane's seeding (Decision 3).
+ * The generator emits the edge bundle at generation time
+ * (dependency-edges.ts); this class is the queryable index built from it.
+ * It is rebuildable from (graph + generator output): re-running the
+ * generator on the same graph re-emits the same bundle, and fromEdges on
+ * that bundle yields an identical index (proven by the rebuildability
+ * test, not by assertion here).
+ *
+ * Fail-closed: fromEdges throws when the bundle is incomplete or
+ * inconsistent with the spec it describes. Unknown/missing dependency
+ * info never silently produces a partial index that claims completeness.
+ *
+ * Scope discipline (what this does NOT do):
+ *  - No reactive recomputation: it is a static snapshot per generation.
+ *  - No claim-level evidence graph: evidence edges ride along in the
+ *    bundle for consumers that need them; the index queries only
+ *    object -> section -> page.
+ *  - No persistence of its own: the bundle is the serializable form.
+ *  - No invalidation execution: it reports the affected set; the regen
+ *    seam (L6) decides what to do with it.
+ */
+
+import type { FYDSiteSpec } from "../sitespec/types";
+import type { GeneratedDependencies } from "./dependency-edges";
+
+export type SectionId = string;
+export type ObjectId = string;
+export type PageSlug = string;
+
+export class DependencyIndex {
+  private objectToSections = new Map<ObjectId, Set<SectionId>>();
+  private sectionToObjects = new Map<SectionId, Set<ObjectId>>();
+  private sectionToPage = new Map<SectionId, PageSlug>();
+
+  /** Low-level registration; prefer fromEdges for generator-built indexes. */
+  register(objectId: ObjectId, sectionIds: SectionId[]): void {
+    let set = this.objectToSections.get(objectId);
+    if (!set) {
+      set = new Set<SectionId>();
+      this.objectToSections.set(objectId, set);
+    }
+    for (const s of sectionIds) {
+      set.add(s);
+      let rev = this.sectionToObjects.get(s);
+      if (!rev) {
+        rev = new Set<ObjectId>();
+        this.sectionToObjects.set(s, rev);
+      }
+      rev.add(objectId);
+    }
+  }
+
+  /**
+   * Build the index from one generation's edge bundle, checked against the
+   * spec that generation produced. Throws (fail closed) when:
+   *  - any section in the spec has no section->page edge (unknown), or
+   *  - any edge references a section id absent from the spec (dangling).
+   * A section registered with zero object contributors (static sections
+   * like AskFYD) is genuinely-none and passes; a section never registered
+   * at all is unknown and fails.
+   */
+  static fromEdges(deps: GeneratedDependencies, spec: FYDSiteSpec): DependencyIndex {
+    const specSections = new Set<SectionId>();
+    for (const page of spec.pages) {
+      for (const s of page.sections) specSections.add(s.id);
+    }
+    const pageOf = new Map<SectionId, PageSlug>();
+    for (const e of deps.sectionToPage) {
+      if (!specSections.has(e.sectionId)) {
+        throw new Error(
+          "dependency-index: section->page edge for unknown section: " + e.sectionId,
+        );
+      }
+      pageOf.set(e.sectionId, e.pageSlug);
+    }
+    for (const sectionId of specSections) {
+      if (!pageOf.has(sectionId)) {
+        throw new Error(
+          "dependency-index: spec section has no dependency edges (unknown): " + sectionId,
+        );
+      }
+    }
+    for (const e of deps.objectToSection) {
+      if (!specSections.has(e.sectionId)) {
+        throw new Error(
+          "dependency-index: object->section edge for unknown section: " + e.sectionId,
+        );
+      }
+    }
+    const idx = new DependencyIndex();
+    idx.sectionToPage = pageOf;
+    for (const e of deps.objectToSection) {
+      idx.register(e.objectId, [e.sectionId]);
+    }
+    // Sections with zero object contributors still resolve to their objects
+    // (empty) and their page; they were explicitly registered as empty.
+    for (const sectionId of specSections) {
+      if (!idx.sectionToObjects.has(sectionId)) {
+        idx.sectionToObjects.set(sectionId, new Set());
+      }
+    }
+    return idx;
+  }
+
+  /** Sections that (re)render when this object changes. Sorted, stable. */
+  sectionsForObject(objectId: ObjectId): SectionId[] {
+    const set = this.objectToSections.get(objectId);
+    return set ? [...set].sort() : [];
+  }
+
+  /** Pages that (re)render when this object changes, via its sections. */
+  pagesForObject(objectId: ObjectId): PageSlug[] {
+    const pages = new Set<PageSlug>();
+    for (const s of this.sectionsForObject(objectId)) {
+      const p = this.sectionToPage.get(s);
+      if (p) pages.add(p);
+    }
+    return [...pages].sort();
+  }
+
+  /** Objects contributing to a section. Empty for static sections. */
+  objectsForSection(sectionId: SectionId): ObjectId[] {
+    const set = this.sectionToObjects.get(sectionId);
+    return set ? [...set].sort() : [];
+  }
+
+  /** The invalidation set for one changed object: its sections. */
+  invalidate(objectId: ObjectId): { sections: SectionId[]; pages: PageSlug[] } {
+    return { sections: this.sectionsForObject(objectId), pages: this.pagesForObject(objectId) };
+  }
+
+  size(): number {
+    return this.objectToSections.size;
+  }
+
+  /**
+   * Canonical serialization for the rebuildability proof: delete the
+   * index, rebuild from (graph + generator output), diff this string.
+   * Identical strings mean identical indexes.
+   */
+  toCanonical(): string {
+    const objects = [...this.objectToSections.keys()].sort();
+    const sections = [...this.sectionToObjects.keys()].sort();
+    const pages: Record<SectionId, PageSlug> = {};
+    for (const s of sections) {
+      const p = this.sectionToPage.get(s);
+      if (p !== undefined) pages[s] = p;
+    }
+    return JSON.stringify({
+      objects: objects.map((o) => [o, this.sectionsForObject(o)]),
+      sections: sections.map((s) => [s, this.objectsForSection(s)]),
+      pages,
+    });
+  }
+}
