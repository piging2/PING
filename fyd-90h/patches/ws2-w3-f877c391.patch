+export function buildPinnedLookup(validated: readonly string[]) {
+  const pinned = [...validated];
+  const familyOf = (address: string): number => (isIP(address) === 6 ? 6 : 4);
+  return (
+    _hostname: string,
+    opts: unknown,
+    callback: (
+      err: Error | null,
+      addresses?: Array<{ address: string; family: number }> | string,
+      family?: number,
