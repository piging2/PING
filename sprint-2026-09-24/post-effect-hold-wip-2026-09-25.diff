index 000000000..1647f4254
--- /dev/null
+++ b/ping-runtime/orchestration/mission_scheduler.reaper_hold.test.js
@@ -0,0 +1,423 @@
+'use strict';
+/**
+ * ORCA reaper-vs-HOLD proof (mission layer P0).
+ *
+ * Gap under test: a mission parked on an H5 HOLD (UNKNOWN outcome awaiting
+ * an operator decision) keeps its `running`/`assigned` status with a stale
+ * 60s lease. The reaper's reapExpiredLeases() used to reset ANY
+ * running/assigned row with an expired lease back to `created`, which the
+ * scheduler's dispatch arrow then auto re-dispatched — an automatic retry
+ * of an unknown outcome, the exact false green HOLD semantics forbid.
+ *
+ * Proved here:
+ *   1. A HELD mission whose lease expires is never reaped, never
+ *      re-dispatched, and the skip is recorded (log + MISSION_LEASE_REAP_SKIPPED_HELD).
+ *   2. The hold survives the row: only a recorded operator decision releases
+ *      it (recordOperatorDecision), after which the mission becomes eligible
+ *      again through the normal conditional-claim path — no deadlock.
+ *   3. A 'fail' decision is terminal; invalid decisions are rejected
+ *      (fail closed) and leave the hold untouched.
+ *   4. The claim gate refuses held missions outright.
+ *   5. Non-held expired leases still reap (no regression).
+ *
+ * Harness: same FakePool + controllable-clock style as
+ * mission_scheduler.retry_watchdog.test.js. The decision logic under test
+ * (reapExpiredLeases, setHeld, recordOperatorDecision, assign, the
+ * scheduler's watchdog) runs for real; the fake only emulates pg wire
+ * semantics for the SQL the runtime issues.
+ *
+ * Run: node --test mission_scheduler.reaper_hold.test.js
+ */
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { MissionRuntime } = require('./mission_runtime.js');
+const { MissionScheduler } = require('./mission_scheduler.js');
+
+// ── Controllable clock ──────────────────────────────────────────────
+let fakeNow = Date.now();
+const realDateNow = Date.now;
+Date.now = () => fakeNow;
+const iso = () => new Date(fakeNow).toISOString();
+
+class FakePool {
+  constructor() { this.missions = new Map(); }
+  _inList(sql) {
+    const m = sql.match(/status IN \(([^)]+)\)/);
+    return m ? m[1].split(',').map(s => s.trim().replace(/'/g, '')) : null;
+  }
+  async query(sql, params = []) {
+    const S = sql.replace(/\s+/g, ' ').trim();
+    if (/^(CREATE|ALTER)/.test(S)) return { rows: [], rowCount: 0 };
+    const byId = (id) => this.missions.get(id);
+
+    if (S.includes('INSERT INTO ping_missions')) {
+      const id = params[0];
+      if (this.missions.has(id)) return { rows: [], rowCount: 0 };
+      this.missions.set(id, {
+        mission_id: id, mission_type: params[1], payload: params[2],
+        priority: params[3] || 0, created_by: params[4] || null,
+        status: 'created', result: null, assigned_to: null,
+        created_at: iso(), started_at: null, completed_at: null,
+        error: null, retries: 0, retry_at: null, lease_until: null, claimed_at: null,
+        tenant_id: params[5] || 'UNKNOWN', held: false, hold_reason: null, decisions: [],
+      });
+      return { rows: [], rowCount: 1 };
+    }
+    if (S.includes('SELECT tenant_id FROM ping_missions')) {
+      const m = byId(params[0]);
+      return m ? { rows: [{ tenant_id: m.tenant_id }], rowCount: 1 } : { rows: [], rowCount: 0 };
+    }
+    if (S.includes('SELECT retries FROM ping_missions')) {
+      const m = byId(params[0]);
+      return m ? { rows: [{ retries: m.retries }], rowCount: 1 } : { rows: [], rowCount: 0 };
+    }
+    if (S.includes('SELECT started_at FROM ping_missions')) {
+      const m = byId(params[0]);
+      return m ? { rows: [{ started_at: m.started_at }], rowCount: 1 } : { rows: [], rowCount: 0 };
+    }
+    if (S.includes('SELECT * FROM ping_missions') && S.includes('WHERE mission_id')) {
+      const m = byId(params[0]);
+      return m ? { rows: [m], rowCount: 1 } : { rows: [], rowCount: 0 };
+    }
+    // setHeld(): persist/clear an H5 HOLD on the row
+    if (S.includes('SET held =') && S.includes('hold_reason = $')) {
+      const m = byId(params[0]);
+      if (!m) return { rows: [], rowCount: 0 };
+      m.held = !!params[1]; m.hold_reason = params[2];
+      return { rows: [], rowCount: 1 };
+    }
+    // recordOperatorDecision(): append to the decisions record, release or fail
+    if (S.includes('SET decisions = COALESCE')) {
+      const m = byId(params[0]);
+      if (!m) return { rows: [], rowCount: 0 };
+      const entries = JSON.parse(params[1]);
+      m.decisions = (m.decisions || []).concat(entries);
+      m.held = false; m.hold_reason = null;
+      if (params[2] === 'release') {
+        m.status = 'created'; m.assigned_to = null; m.started_at = null;
+        m.lease_until = null; m.claimed_at = null;
+      } else {
+        m.status = 'failed'; m.error = params[3]; m.completed_at = iso();
+      }
+      return { rows: [{ mission_id: m.mission_id, status: m.status }], rowCount: 1 };
+    }
+    if (S.includes("SET status = 'assigned'")) {
+      const m = byId(params[1]);
+      if (!m || m.status !== 'created' || m.held === true) return { rows: [], rowCount: 0 };
+      m.status = 'assigned'; m.assigned_to = params[0];
+      m.claimed_at = iso(); m.lease_until = new Date(fakeNow + 60000).toISOString();
+      return { rows: [{ mission_id: m.mission_id }], rowCount: 1 };
+    }
+    if (S.includes("SET status = 'running'")) {
+      const m = byId(params[0]);
+      if (!m || m.status !== 'assigned') return { rows: [], rowCount: 0 };
+      m.status = 'running'; m.started_at = iso();
+      return { rows: [], rowCount: 1 };
+    }
+    if (S.includes("SET status = 'completed'")) {
+      const m = byId(params[1]);
+      if (!m || m.status !== 'running') return { rows: [], rowCount: 0 };
+      m.status = 'completed'; m.result = params[0]; m.completed_at = iso();
+      m.held = false; m.hold_reason = null;
+      return { rows: [], rowCount: 1 };
+    }
+    if (S.includes("SET status = 'retry_pending'")) {
+      const m = byId(params[3]);
+      const allowed = this._inList(S) || [];
+      if (!m || !allowed.includes(m.status)) return { rows: [], rowCount: 0 };
+      m.status = 'retry_pending'; m.error = params[0]; m.retries = params[1]; m.retry_at = params[2];
+      m.held = false; m.hold_reason = null;
+      return { rows: [], rowCount: 1 };
+    }
+    if (S.includes("SET status = 'failed'") && S.includes('retries')) {
+      const m = byId(params[2]);
+      const allowed = this._inList(S) || [];
+      if (!m || !allowed.includes(m.status)) return { rows: [], rowCount: 0 };
+      m.status = 'failed'; m.error = params[0]; m.retries = params[1]; m.completed_at = iso();
+      m.held = false; m.hold_reason = null;
+      return { rows: [], rowCount: 1 };
+    }
+    if (S.includes("SET status = 'failed'")) {
+      const m = byId(params[1]);
+      const allowed = this._inList(S) || [];
+      if (!m || !allowed.includes(m.status)) return { rows: [], rowCount: 0 };
+      m.status = 'failed'; m.error = params[0]; m.completed_at = iso();
+      m.held = false; m.hold_reason = null;
+      return { rows: [], rowCount: 1 };
+    }
+    // reclaimRetryPending(): retry_pending + due retry_at -> created (never held)
+    if (S.includes("SET status = 'created'") && S.includes('retry_at = NULL')) {
+      const out = [];
+      for (const m of this.missions.values()) {
+        if (m.status === 'retry_pending' && m.retry_at && Date.parse(m.retry_at) <= fakeNow && m.held !== true) {
+          m.status = 'created'; m.assigned_to = null; m.lease_until = null;
+          m.claimed_at = null; m.retry_at = null;
+          out.push({ mission_id: m.mission_id });
+        }
+      }
+      return { rows: out, rowCount: out.length };
+    }
+    // reapExpiredLeases(): running/assigned + expired lease -> created (never held)
+    if (S.includes("SET status = 'created'")) {
+      const out = [];
+      for (const m of this.missions.values()) {
+        if (['running', 'assigned'].includes(m.status) && m.lease_until && Date.parse(m.lease_until) < fakeNow && m.held !== true) {
+          m.status = 'created'; m.assigned_to = null; m.lease_until = null;
+          m.claimed_at = null; m.retry_at = iso();
+          out.push({ mission_id: m.mission_id });
+        }
+      }
+      return { rows: out, rowCount: out.length };
+    }
+    // reapExpiredLeases(): recorded skip — held missions whose lease expired
+    if (S.includes('SELECT mission_id FROM ping_missions')) {
+      const out = [];
+      for (const m of this.missions.values()) {
+        if (['running', 'assigned'].includes(m.status) && m.lease_until && Date.parse(m.lease_until) < fakeNow && m.held === true) {
+          out.push({ mission_id: m.mission_id });
+        }
+      }
+      return { rows: out, rowCount: out.length };
+    }
+    if (S.includes('SET lease_until = NOW()')) {
+      const m = byId(params[1]);
+      if (!m || !['running', 'assigned'].includes(m.status) || !m.lease_until) return { rows: [], rowCount: 0 };
+      m.lease_until = new Date(fakeNow + params[0] * 1000).toISOString();
+      return { rows: [], rowCount: 1 };
+    }
+    // findStuckRunning() — already-held missions excluded (no duplicate HOLD)
+    if (S.includes('COALESCE(started_at')) {
+      const cutoff = Date.parse(params[0]);
+      const rows = [...this.missions.values()].filter(m =>
+        ['running', 'assigned'].includes(m.status) &&
+        m.held !== true &&
+        Date.parse(m.started_at || m.claimed_at || m.created_at) < cutoff);
+      return { rows, rowCount: rows.length };
+    }
+    // getPending(): created ONLY
+    if (S.includes('WHERE status =') && S.includes('LIMIT')) {
+      const limit = params[0] || 10;
+      const rows = [...this.missions.values()]
+        .filter(m => m.status === 'created')
+        .sort((a, b) => (b.priority || 0) - (a.priority || 0))
+        .slice(0, limit);
+      return { rows, rowCount: rows.length };
+    }
+    throw new Error(`FakePool: unhandled SQL: ${S.slice(0, 140)}`);
+  }
+}
+
+function makeHarness(opts = {}) {
+  fakeNow = realDateNow(); // fresh clock per harness — no cross-test leakage
+  const pool = new FakePool();
+  const emitted = [];
+  const eventRuntime = {
+    emitted,
+    async emit(type, source, payload = {}) { emitted.push({ type, source, payload }); return { status: 'ok' }; },
+  };
+  const harness = { pool, events: eventRuntime, workerInvocations: 0 };
+  const behaviors = {
+    hanging: () => { harness.workerInvocations++; return new Promise(() => {}); },
+    ok: async () => { harness.workerInvocations++; return { status: 'ok' }; },
+  };
+  let behavior = opts.worker || 'hanging';
+  const workerRuntime = {
+    getStats: () => ({ workers: { observation: {} } }),
+    dispatch: (event) => behaviors[behavior](event),
+  };
+  const mr = new MissionRuntime({ pool, eventRuntime });
+  const sched = new MissionScheduler({
+    missionRuntime: mr,
+    workerRuntime,
+    eventRuntime,
+    retryPolicy: { max_attempts: 3, backoff_delay_ms: 5000 },
+    pollIntervalMs: 3600000, // manual _poll() only
+    dispatchTimeoutMs: opts.dispatchTimeoutMs || 50,
+    stuckThresholdMs: opts.stuckThresholdMs || 600000,
+  });
+  harness.mr = mr;
+  harness.sched = sched;
+  harness.setWorker = (b) => { behavior = b; };
+  harness.advance = (ms) => { fakeNow += ms; };
+  harness.now = () => fakeNow;
+  return harness;
+}
+
+function holds(h) {
+  return h.events.emitted.filter(e => e.type === 'MISSION_RECONCILE_HOLD');
+}
+
+function skips(h) {
+  return h.events.emitted.filter(e => e.type === 'MISSION_LEASE_REAP_SKIPPED_HELD');
+}
+
+// Dispatch a mission through a hanging worker so the dispatch timeout fires
+// and the watchdog parks it on an H5 HOLD. Returns the mission id.
+async function parkOnHold(h, tag) {
+  const id = await h.mr.create('LEAD_FOLLOWUP', {
+    event_id: `evt-${tag}`, event_type: 'LEAD_CREATED', correlation_id: `corr-${tag}`,
+  }, { tenant_id: 't1' });
+  // The dispatch timeout uses an unref'd timer (it must never hold the
+  // process open in production). Keep a ref'd handle alive for the test so
+  // the event loop survives until the timer fires.
+  const keepAlive = setInterval(() => {}, 1000);
+  try {
+    await h.sched._poll(); // dispatch hangs -> 50ms timeout -> HOLD
+  } finally {
+    clearInterval(keepAlive);
+  }
+  return id;
+}
+
+// ── The proof ───────────────────────────────────────────────────────
+
+
+// ── The proof ───────────────────────────────────────────────────────
+
+test('reaper: a HELD mission whose lease expires is never re-dispatched; the skip is recorded', async () => {
+  const h = makeHarness({ worker: 'hanging', dispatchTimeoutMs: 50 });
+  const id = await parkOnHold(h, 'rh1');
+
+  // The watchdog parked it: HOLD persisted to the row, exactly one dispatch.
+  let m = h.pool.missions.get(id);
+  assert.equal(m.status, 'running', 'watchdog never mutates the row status');
+  assert.equal(m.held, true, 'HOLD persisted to the mission row');
+  assert.equal(holds(h).length, 1, 'exactly one HOLD reconciliation record emitted');
+  assert.equal(h.workerInvocations, 1, 'exactly one physical dispatch');
+
+  // The lease expires through the ~60s re-dispatch path.
+  h.advance(61000);
+  const reaped = await h.mr.reapExpiredLeases();
+  assert.equal(reaped, 0, 'reaper reclaims zero held missions');
+
+  // The skip is recorded — silence here would be the false green.
+  const rec = skips(h);
+  assert.equal(rec.length, 1, 'one recorded skip for the held mission');
+  assert.equal(rec[0].payload.missionId, id);
+
+  // Row untouched, hold intact.
+  m = h.pool.missions.get(id);
+  assert.equal(m.status, 'running');
+  assert.equal(m.held, true);
+  assert.ok(!h.events.emitted.some(e => e.type === 'MISSION_LEASE_EXPIRED' && e.payload.missionId === id),
+    'no MISSION_LEASE_EXPIRED for a held mission');
+
+  // Full poll cycle: reaper arrow + dispatch arrow. Still no re-dispatch.
+  await h.sched._poll();
+  assert.equal(h.workerInvocations, 1, 'zero automatic re-dispatch of the held mission');
+  const pending = await h.mr.getPending(10);
+  assert.ok(!pending.some(p => p.mission_id === id), 'held mission never becomes pending');
+  m = h.pool.missions.get(id);
+  assert.equal(m.status, 'running');
+  assert.equal(m.held, true);
+});
+
+test('operator: a release decision re-enables the mission through the claim path (no deadlock)', async () => {
+  const h = makeHarness({ worker: 'hanging', dispatchTimeoutMs: 50 });
+  const id = await parkOnHold(h, 'rh2');
+  h.advance(61000);
+  await h.sched._poll();
+  assert.equal(h.workerInvocations, 1, 'held through the full poll cycle');
+
+  // The operator decides, with a recorded reason. This is the ONLY release path.
+  const entry = await h.mr.recordOperatorDecision(id, {
+    action: 'release',
+    reason: 'operator verified exactly one effect; safe to re-dispatch',
+    decided_by: 'nolan',
+  });
+  assert.equal(entry.action, 'release');
+  assert.equal(entry.decided_by, 'nolan');
+  assert.ok(entry.decided_at, 'decision timestamp recorded');
+
+  let m = h.pool.missions.get(id);
+  assert.equal(m.held, false, 'hold cleared');
+  assert.equal(m.status, 'created', 'eligible again via the created state');
+  assert.equal(m.decisions.length, 1, 'decisions record holds the operator decision');
+  assert.deepEqual(m.decisions[0], entry);
+  const dec = h.events.emitted.filter(e => e.type === 'MISSION_OPERATOR_DECISION');
+  assert.equal(dec.length, 1);
+  assert.equal(dec[0].payload.missionId, id);
+
+  // Now the mission CAN proceed: normal conditional-claim dispatch, exactly once.
+  h.setWorker('ok');
+  await h.sched._poll();
+  assert.equal(h.workerInvocations, 2, 'released mission dispatched exactly once more');
+  assert.equal(h.pool.missions.get(id).status, 'completed');
+});
+
+test('operator: a fail decision is terminal and never re-dispatched', async () => {
+  const h = makeHarness({ worker: 'hanging', dispatchTimeoutMs: 50 });
+  const id = await parkOnHold(h, 'rh3');
+
+  const entry = await h.mr.recordOperatorDecision(id, {
+    action: 'fail',
+    reason: 'effect confirmed duplicated upstream; do not retry',
+  });
+  assert.equal(entry.action, 'fail');
+  let m = h.pool.missions.get(id);
+  assert.equal(m.status, 'failed');
+  assert.equal(m.error, 'effect confirmed duplicated upstream; do not retry');
+  assert.equal(m.held, false);
+  assert.equal(m.decisions.length, 1);
+
+  h.advance(120000);
+  await h.sched._poll();
+  assert.equal(h.workerInvocations, 1, 'no re-dispatch after a fail decision');
+  assert.equal(h.pool.missions.get(id).status, 'failed');
+});
+
+test('operator: decisions fail closed — invalid input leaves the hold untouched', async () => {
+  const h = makeHarness({ worker: 'hanging', dispatchTimeoutMs: 50 });
+  const id = await parkOnHold(h, 'rh4');
+
+  await assert.rejects(
+    h.mr.recordOperatorDecision(id, { action: 'retry', reason: 'nope' }),
+    /unknown action/,
+    'unknown actions are rejected'
+  );
+  await assert.rejects(
+    h.mr.recordOperatorDecision(id, { action: 'release', reason: '   ' }),
+    /non-empty reason/,
+    'empty reasons are rejected'
+  );
+  await assert.rejects(
+    h.mr.recordOperatorDecision('mission-that-does-not-exist', { action: 'release', reason: 'x' }),
+    /not found/,
+    'unknown missions are rejected'
+  );
+
+  const m = h.pool.missions.get(id);
+  assert.equal(m.held, true, 'hold untouched by rejected decisions');
+  assert.equal(m.status, 'running');
+  assert.equal(m.decisions.length, 0, 'nothing recorded');
+});
+
+test('claim gate: a held mission is never claimable, even with status manually reset to created', async () => {
+  const h = makeHarness({ worker: 'hanging', dispatchTimeoutMs: 50 });
+  const id = await parkOnHold(h, 'rh5');
+
+  // Simulate a manual/errant status reset: the row is created but still held.
+  h.pool.missions.get(id).status = 'created';
+  assert.equal(await h.mr.assign(id, 'observation'), 0, 'claim guard refuses held rows');
+  const m = h.pool.missions.get(id);
+  assert.equal(m.status, 'created', 'no state change from the refused claim');
+  assert.equal(m.held, true, 'hold intact');
+  assert.equal(m.assigned_to, 'observation', 'assigned_to untouched by the refused claim');
+});
+
+test('reaper: non-held expired leases still reap (no regression)', async () => {
+  const h = makeHarness({ worker: 'ok' });
+  const id = await h.mr.create('LEAD_FOLLOWUP', {
+    event_id: 'evt-rh6', event_type: 'LEAD_CREATED',
+  }, { tenant_id: 't1' });
+  assert.equal(await h.mr.assign(id, 'observation'), 1);
+
+  h.advance(61000);
+  assert.equal(await h.mr.reapExpiredLeases(), 1, 'orphan without a hold is reclaimed');
+  const m = h.pool.missions.get(id);
+  assert.equal(m.status, 'created');
+  const expired = h.events.emitted.filter(e => e.type === 'MISSION_LEASE_EXPIRED');
+  assert.equal(expired.length, 1);
+  assert.equal(skips(h).length, 0, 'no skip recorded for a non-held mission');
+});
