{"$comment":"PING schema sketch: machine-readable companion to atproto-schema-lessons.md. One schema fans out into validator, types, object mapping, relationships, capabilities, renderer, agent tool, and form. Evolution law: new fields optional only; no type changes; no removals; tolerate unknown fields; breaking change mints a new version.","chain":["SCHEMA","VALIDATOR","OBJECT","RELATIONSHIPS","CAPABILITIES","RENDERER","AGENT TOOLS"],"schemas":[{"derivations":{"agentTool":{"description":"Create a short post as the calling identity. Text max 2000 chars. replyTo must be an exact PING object ID. Visibility defaults to PING_ONLY; PUBLIC requires explicit user confirmation.","inputSchema":{"$ref":"#/record"},"name":"ping.post.create","requiresCapability":"post.publish"},"capabilities":{"grants":["post.publish (author identity only)","post.delete (author only)"],"note":"post.like is a separate grant; publishing never implies liking"},"form":{"fields":[{"maxLength":2000,"name":"text","required":true,"widget":"textarea"},{"name":"replyTo","required":false,"widget":"object-picker"},{"name":"visibility","options":["PING_ONLY","PRIVATE","PUBLIC"],"required":false,"widget":"select"}]},"objectMapping":{"canonicalEvent":"OBJECT_CREATED","identityBinding":"author must equal the signing subject","objectKind":"post"},"relationships":[{"event":"RELATIONSHIP_CREATED","from":"record.replyTo","predicate":"replies_to"},{"event":"RELATIONSHIP_CREATED","from":"facets[] where kind=mention","predicate":"mentions"}],"renderer":{"activitypub":{"gate":"visibility PUBLIC only","projectsTo":"Note"},"web":{"component":"PostCard","props":["text","author","createdAt","replyTo"]}},"typescript":{"emits":"interface PingSocialPostV1 { $type: 'ping.social.post@1'; author: string; text: string; createdAt: string; replyTo?: string; visibility?: 'PUBLIC' | 'PRIVATE' | 'PING_ONLY'; facets?: Array<{ kind: 'mention' | 'link'; target: string }>; }","from":"record","tool":"json-schema-to-typescript"},"validator":{"emits":"validatePost(input)","from":"record","tool":"ajv (JSON Schema draft 2020-12)"}},"description":"A short post authored by a PING identity.","kind":"record","nsid":"ping.social.post","record":{"$id":"https://ping.social/schemas/ping.social.post@1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"$type":{"const":"ping.social.post@1"},"author":{"format":"ping-identity-ref","type":"string"},"createdAt":{"format":"date-time","type":"string"},"facets":{"items":{"additionalProperties":false,"properties":{"kind":{"enum":["mention","link"],"type":"string"},"target":{"type":"string"}},"required":["kind","target"],"type":"object"},"type":"array"},"replyTo":{"format":"ping-object-ref","type":"string"},"text":{"maxLength":2000,"type":"string"},"visibility":{"default":"PING_ONLY","enum":["PUBLIC","PRIVATE","PING_ONLY"],"type":"string"}},"required":["$type","author","text","createdAt"],"type":"object"},"validation":{"evolution":{"breakingChange":"mint-new-version","fieldRemoval":"forbidden","newFields":"must-be-optional","typeChanges":"forbidden"},"unknownFields":"tolerate"},"version":1},{"derivations":{"agentTool":{"description":"Publish a service offering for the calling business identity. Never invent pricing; priceHint only from owner-supplied text.","inputSchema":{"$ref":"#/record"},"name":"ping.service.create","requiresCapability":"service.publish"},"capabilities":{"grants":["service.publish (business identity only)"]},"form":{"fields":[{"maxLength":120,"name":"name","required":true,"widget":"text"},{"name":"description","required":false,"widget":"textarea"},{"name":"priceHint","required":false,"widget":"text"},{"name":"serviceArea","required":false,"widget":"tag-list"}]},"objectMapping":{"canonicalEvent":"OBJECT_CREATED","objectKind":"service"},"relationships":[{"event":"RELATIONSHIP_CREATED","from":"record.business","predicate":"offers"}],"renderer":{"activitypub":{"gate":"future; federate defaults false","proj