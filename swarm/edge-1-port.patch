+/**
+ * EDGE-1 resolve tests: the object sheet builder.
+ *
+ * Proves, on BOTH fixture graphs with ZERO business-name conditionals:
+ * - every edge item maps to a real object id (the invariant)
+ * - edge-kind resolution from (predicate, target schema)
+ * - unknown predicates fall through to generic_edge (never a dead end)
+ * - capability-resolved actions only (no invented buttons; no
+ *   request_quote because the capability does not exist in this tree)
+ * - deterministic ordering
+ * - claim classification on summary and claims
+ * - the visibility gate: hidden objects yield null (the HTTP layer maps
+ *   null to 404, indistinguishable from "unknown")
+ */
+
+import { buildObjectSheet, resolveEdgeKind, predicateLabel } from "../resolve";
+import { EDGE_RENDER_INVARIANT } from "../types";
+import { VISITOR_VIEWER } from "../../visibility/policy";
+import { HAPPY_PLACE_GRAPH } from "../../proceduralize/__fixtures__/happy-place-graph";
+import { COPPERSMITH_PLUMBING_GRAPH } from "../../proceduralize/__fixtures__/coppersmith-plumbing-graph";
+import type { ObjectGraph } from "../../sitespec/types";
+import type { PingObject } from "@/lib/ping/types";
+
+const HPP_BUSINESS = "website-business-9d13c4196b4f1092";
+const COPPER_BUSINESS = "website-business-0061cd1c2f8f4d0b";
+
+describe("the invariant is written down", () => {
+  test("EDGE_RENDER_INVARIANT names the functional doorway", () => {
+    expect(EDGE_RENDER_INVARIANT).toContain("FUNCTIONAL DOORWAY");
+    expect(EDGE_RENDER_INVARIANT).toContain("AUTHORIZED BUSINESS GRAPH");
+  });
+});
+
+describe.each([
+  ["happy-place", HAPPY_PLACE_GRAPH, HPP_BUSINESS, 5],
+  ["coppersmith-plumbing", COPPERSMITH_PLUMBING_GRAPH, COPPER_BUSINESS, 4],
+])("business sheet (%s): same system, different data", (_slug, graph, bizId, serviceCount) => {
+  test("sheet resolves with identity, type, summary, edges, actions", () => {
+    const sheet = buildObjectSheet(graph, bizId, VISITOR_VIEWER);
+    expect(sheet).not.toBeNull();
+    const s = sheet!;
+    expect(s.objectId).toBe(bizId);
+    expect(s.title.length).toBeGreaterThan(0);
+    expect(s.typeLabel).toBe("Business");
+    expect(s.schemaRole).toBe("business");
+    expect(s.summary.length).toBeGreaterThan(0);
+    expect(s.edgeGroups.length).toBeGreaterThan(0);
+    expect(s.actions.length).toBeGreaterThan(0);
+    expect(s.visibility).toBe("public");
+  });
+
+  test("offers group holds the services, each a real doorway", () => {
+    const s = buildObjectSheet(graph, bizId, VISITOR_VIEWER)!;
+    const offers = s.edgeGroups.find((g) => g.predicate === "offers");
+    expect(offers).toBeDefined();
+    expect(offers!.totalCount).toBe(serviceCount);
+    const byId = new Map(graph.objects.map((o) => [o.id, o]));
+    for (const item of offers!.items) {
+      // INVARIANT: every edge item maps to a real object id.
+      const target = byId.get(item.targetObjectId);
+      expect(target).toBeDefined();
+      expect(target!.schema).toBe("ping.social.service@1");
+      expect(item.kind).toBe("service_edge");
+      expect(item.targetTitle).toBe(target!.title);
+      expect(item.evidenceRef.length).toBeGreaterThan(0);
+    }
+  });
+
+  test("actions come from the capability path only", () => {
+    const s = buildObjectSheet(graph, bizId, VISITOR_VIEWER)!;
+    const kinds = s.actions.map((a) => a.kind);
+    expect(kinds).toContain("ask");
+    expect(kinds).toContain("why_this");
+    expect(kinds).toContain("open_full_node");
+    expect(kinds).toContain("reference");
+    // "request_quote" is not a resolved capability in this tree, so no
+    // Request-quote button may be rendered. If the capability lands, its
+    // action appears with zero UI changes.
+    expect(kinds).not.toContain("request_quote");
+    for (const a of s.actions) {
+      expect(a.capability.length).toBeGreaterThan(0);
+    }
+  });
+
+  test("summary is an evidence-backed direct fact, not marketing copy", () => {
+    const s = buildObjectSheet(graph, bizId, VISITOR_VIEWER)!;
+    expect(s.summaryClaimClass).toBe("DIRECT_FACT");
+    expect(s.provenanceRef).toContain("website-ingestion");
+  });
+
+  test("edge ordering is deterministic across runs", () => {
+    const a = JSON.stringify(buildObjectSheet(graph, bizId, VISITOR_VIEWER));
+    const b = JSON.stringify(buildObjectSheet(graph, bizId, VISITOR_VIEWER));
+    expect(a).toBe(b);
+  });
+});
+
+describe("service sheets", () => {
+  test("a service expands to description, evidence, and Ask/Reference actions", () => {
+    const service = HAPPY_PLACE_GRAPH.objects.find(
+      (o) => o.schema === "ping.social.service@1",
+    )!;
+    const s = buildObjectSheet(HAPPY_PLACE_GRAPH, service.id, VISITOR_VIEWER)!;
+    expect(s.typeLabel).toBe("Service");
+    expect(s.summary).toBe(service.description);
+    const kinds = s.actions.map((a) => a.kind);
+    expect(kinds).toContain("ask");
+    expect(kinds).toContain("reference");
+    expect(kinds).toContain("why_this");
+    // No website field on services -> no open_website action invented.
+    expect(kinds).not.toContain("open_website");
+  });
+
+  test("business with a website field resolves open_website with a safe href", () => {
+    const s = buildObjectSheet(HAPPY_PLACE_GRAPH, HPP_BUSINESS, VISITOR_VIEWER)!;
+    const web = s.actions.find((a) => a.kind === "open_website");
+    expect(web).toBeDefined();
+    expect(web!.href).toBe("https://happyplacecarpentry.com");
+  });
+});
+
+describe("edge-kind resolution", () => {
+  test("matrix: predicate + schema role decide, nothing else", () => {
+    expect(resolveEdgeKind("offers", "ping.social.service@1")).toBe("service_edge");
+    expect(resolveEdgeKind("provides", "ping.social.service@1")).toBe("service_edge");
+    expect(resolveEdgeKind("located_at", "ping.social.location@1")).toBe("location_edge");
+    expect(resolveEdgeKind("works_for", "ping.social.person@1")).toBe("person_edge");
+    expect(resolveEdgeKind("employs", "ping.social.person@1")).toBe("person_edge");
+    expect(resolveEdgeKind("links_to", "ping.social.location@1")).toBe("external_identity_edge");
+    expect(resolveEdgeKind("has_website", "ping.social.business@1")).toBe("external_identity_edge");
+    expect(resolveEdgeKind("references", "ping.social.post@1")).toBe("reference_edge");
+    expect(resolveEdgeKind("provided_by", "ping.social.business@1")).toBe("business_edge");
+  });
+
+  test("UNKNOWN predicate falls through to the generic renderer, never dropped", () => {
+    expect(resolveEdgeKind("mystery_predicate", "ping.social.service@1")).toBe("service_edge");
+    expect(resolveEdgeKind("mystery_predicate", "ping.social.post@1")).toBe("reference_edge");
+    expect(resolveEdgeKind("mystery_predicate", "ping.social.unknown@9")).toBe("generic_edge");
+  });
+
+  test("unknown predicate still renders a labeled, traversable group", () => {
+    const graph: ObjectGraph = {
+      objects: [
+        makeObject("b1", "ping.social.business@1", "B Co"),
+        makeObject("x1", "ping.social.unknown@9", "X Thing"),
+      ],
+      relationships: [
+        {
+          id: "r1",
+          subject: "b1",
+          predicate: "mystery_predicate",
+          object: "x1",
+          status: "active",
+          createdAt: "2026-09-24T00:00:00Z",
+          evidenceRef: "service-cards:probe:x",
+        },
+      ],
+    };
+    const s = buildObjectSheet(graph, "b1", VISITOR_VIEWER)!;
+    expect(s.edgeGroups).toHaveLength(1);
+    const g = s.edgeGroups[0];
+    expect(g.kind).toBe("generic_edge");
+    expect(g.label).toBe("Mystery Predicate");
+    expect(g.items).toHaveLength(1);
+    expect(g.items[0].targetObjectId).toBe("x1");
+  });
+});
+
+describe("predicate labels", () => {
+  test("vocabulary labels without business conditionals", () => {
+    expect(predicateLabel("offers")).toBe("Services offered");
+    expect(predicateLabel("located_at")).toBe("Location");
+    expect(predicateLabel("works_for")).toBe("People");
+    expect(predicateLabel("links_to")).toBe("Connected");
+    expect(predicateLabel("some_new_predicate")).toBe("Some New Predicate");
+  });
+});
+
+describe("the visibility gate", () => {
+  test("a hidden object yields null: no sheet, no oracle", () => {
+    const hidden: ObjectGraph = {
+      objects: HAPPY_PLACE_GRAPH.objects.map((o) =>
+        o.id === HPP_BUSINESS ? { ...o, visibility: "private" } : o,
+      ),
+      relationships: [...HAPPY_PLACE_GRAPH.relationships],
+    };
+    expect(buildObjectSheet(hidden, HPP_BUSINESS, VISITOR_VIEWER)).toBeNull();
+  });
+
+  test("hidden edge targets never appear in any sheet", () => {
+    const serviceId = HAPPY_PLACE_GRAPH.objects.find(
+      (o) => o.schema === "ping.social.service@1",
+    )!.id;
+    const hidden: ObjectGraph = {
+      objects: HAPPY_PLACE_GRAPH.objects.map((o) =>
+        o.id === serviceId ? { ...o, visibility: "private" } : o,
+      ),
+      relationships: [...HAPPY_PLACE_GRAPH.relationships],
+    };
+    const s = buildObjectSheet(hidden, HPP_BUSINESS, VISITOR_VIEWER)!;
+    const offers = s.edgeGroups.find((g) => g.predicate === "offers")!;
+    expect(offers.totalCount).toBe(4);
+    expect(
+      offers.items.some((i) => i.targetObjectId === serviceId),
+    ).toBe(false);
+    // The edge touching the hidden object is dropped too.
+    expect(JSON.stringify(s)).not.toContain(serviceId);
+  });
+
+  test("unknown object id yields null", () => {
+    expect(
+      buildObjectSheet(HAPPY_PLACE_GRAPH, "no-such-object", VISITOR_VIEWER),
+    ).toBeNull();
+  });
+});
+
+describe("attention model", () => {
+  test("the payload carries every authorized item; the client caps rendering", () => {
+    const objects = [makeObject("b1", "ping.social.business@1", "B Co")];
+    const relationships = [];
+    for (let i = 0; i < 20; i++) {
+      objects.push(makeObject("s" + i, "ping.social.service@1", "Service " + i));
+      relationships.push({
+        id: "r" + i,
+        subject: "b1",
+        predicate: "offers",
+        object: "s" + i,
+        status: "active",
+        createdAt: "2026-09-24T00:00:00Z",
+        evidenceRef: "service-cards:probe:s" + i,
+      });
+    }
+    const graph: ObjectGraph = { objects, relationships };
+    const sheet = buildObjectSheet(graph, "b1", VISITOR_VIEWER)!;
+    const offers = sheet.edgeGroups.find((g) => g.predicate === "offers")!;
+    // All 20 authorized items are in the payload (progressive disclosure
+    // never invents objects); the client renders EDGE_ATTENTION_LIMIT
+    // at a time. The graph may hold 100 objects; the edge never shows
+    // 100 at once.
+    expect(offers.totalCount).toBe(20);
+    expect(offers.items).toHaveLength(20);
+    for (const item of offers.items) {
+      expect(objects.some((o) => o.id === item.targetObjectId)).toBe(true);
+    }
+  });
+});
+
+describe("claim classification", () => {
+  test("every claim carries a class; generated copy never poses as fact", () => {
+    const s = buildObjectSheet(HAPPY_PLACE_GRAPH, HPP_BUSINESS, VISITOR_VIEWER)!;
+    const classes = new Set(s.claims.map((c) => c.claimClass));
+    expect(classes.has("DIRECT_FACT")).toBe(true);
+    // The neighborhood-size claim is computed -> DERIVED_FACT.
+    const derived = s.claims.find((c) => c.label === "Connected objects");
+    expect(derived).toBeDefined();
+    expect(derived!.claimClass).toBe("DERIVED_FACT");
+    for (const c of s.claims) {
+      expect(["DIRECT_FACT", "DERIVED_FACT", "OWNER_AUTHORED", "GENERATED_COPY"]).toContain(c.claimClass);
+    }
+  });
+});
+
+describe("group ordering", () => {
+  test("offers ranks before unknown predicates", () => {
+    const graph: ObjectGraph = {
+      objects: [
+        makeObject("b1", "ping.social.business@1", "B Co"),
+        makeObject("s1", "ping.social.service@1", "S One"),
+        makeObject("x1", "ping.social.unknown@9", "X Thing"),
+      ],
+      relationships: [
+        {
+          id: "r2",
+          subject: "b1",
+          predicate: "zzz_custom",
+          object: "x1",
+          status: "active",
+          createdAt: "2026-09-24T00:00:00Z",
+          evidenceRef: "service-cards:probe:x",
+        },
+        {
+          id: "r1",
+          subject: "b1",
+          predicate: "offers",
+          object: "s1",
+          status: "active",
+          createdAt: "2026-09-24T00:00:00Z",
+          evidenceRef: "service-cards:probe:s",
+        },
+      ],
