+/**
+ * FYD-Q2 HOSTILE TEST (mandatory): privacy survives expansion.
+ *
+ * Scenario: the owner HIDES the business address. The hidden location
+ * object (visibility "private") must be unrecoverable through every
+ * expansion path a visitor can reach:
+ *
+ *   1. business edge -> location (object sheet traversal)
+ *   2. Ask FYD -> location (object-scoped ask)
+ *   3. search -> location (query resolution)
+ *   4. related object -> location (traverse from any visible object)
+ *   5. why-this -> location (the route's visibility gate)
+ *
+ * ZERO public disclosure on every attempt. The edge graph must never
+ * become a privacy bypass.
+ *
+ * The hostile graph is built in-memory (fixtures are machine-generated
+ * and must not be hand-edited): Coppersmith + a private location object
+ * carrying a street address the fixtures never contain. All attacks run
+ * through the REAL code paths the HTTP layer calls (buildObjectSheet,
+ * answerVisitorQuestion, resolveQuery, canSee). The demo-owner control
+ * proves the fact survives hiding (visibility policy, not deletion):
+ * the owner still sees the seam-labeled private state.
+ */
+
+import { buildObjectSheet } from "../resolve";
+import { VISITOR_VIEWER, canSee } from "../../visibility/policy";
+import { answerVisitorQuestion } from "../../ask/visitor";
+import { resolveQuery } from "../../components/renderer";
+import { COPPERSMITH_PLUMBING_GRAPH } from "../../proceduralize/__fixtures__/coppersmith-plumbing-graph";
+import type { ObjectGraph } from "../../sitespec/types";
+import type { PingObject, PingRelationship } from "@/lib/ping/types";
+
+const COPPER_BUSINESS = "website-business-0061cd1c2f8f4d0b";
+const HIDDEN_LOCATION_ID = "test-hidden-location-0001";
+const HIDDEN_ADDRESS = "742 Hidden Lane, Grand Junction, CO 81501";
+
+/** The hostile graph: Coppersmith plus a HIDDEN location. The address
+ *  string appears nowhere in the fixtures, so any appearance in an
+ *  attack result is a leak, full stop. */
+function hostileGraph(): ObjectGraph {
+  const location: PingObject = {
+    id: HIDDEN_LOCATION_ID,
+    schema: "ping.social.location@1",
+    controllerId: "identity_fyd_compiler_test",
+    visibility: "private", // OWNER HIDES THE ADDRESS
+    title: "Coppersmith Plumbing & HVAC headquarters",
+    description: "The business street address.",
+    fields: {
+      claimKind: "website_statement",
+      street_address: HIDDEN_ADDRESS,
+      evidence_ref: "service-cards:contact:address",
+    },
+    createdAt: "2026-09-24T00:00:00Z",
+    updatedAt: "2026-09-24T00:00:00Z",
+    provenance: {
+      kind: "website-derived",
+      ref: "website-ingestion:https://coppersmith.example/",
+      derivedAt: "2026-09-24T00:00:00Z",
+    },
+  };
+  const edge: PingRelationship = {
+    id: "rel-test-hidden-located-at",
+    subject: COPPER_BUSINESS,
+    predicate: "located_at",
+    object: HIDDEN_LOCATION_ID,
+    status: "active",
+    createdAt: "2026-09-24T00:00:00Z",
+    evidenceRef: "service-cards:contact:address",
+  };
+  return {
+    objects: [...COPPERSMITH_PLUMBING_GRAPH.objects, location],
+    relationships: [...COPPERSMITH_PLUMBING_GRAPH.relationships, edge],
+  };
+}
+
+const DEMO_OWNER = { id: "demo-owner", displayName: null, mode: "demo_owner" } as const;
+
+describe("FYD-Q2: HIDE address, then attack", () => {
+  test("sanity: the hostile address is unique to the hostile graph", () => {
+    const clean = JSON.stringify(COPPERSMITH_PLUMBING_GRAPH);
+    expect(clean).not.toContain(HIDDEN_ADDRESS);
+    expect(JSON.stringify(hostileGraph())).toContain(HIDDEN_ADDRESS);
+  });
+
+  test("ATTACK 1: business edge -> location yields nothing", () => {
+    const sheet = buildObjectSheet(hostileGraph(), COPPER_BUSINESS, VISITOR_VIEWER)!;
+    expect(sheet).not.toBeNull();
+    // No located_at group survives the gate.
+    expect(sheet.edgeGroups.some((g) => g.predicate === "located_at")).toBe(false);
+    // No edge item anywhere targets the hidden object.
+    for (const g of sheet.edgeGroups) {
+      for (const item of g.items) {
+        expect(item.targetObjectId).not.toBe(HIDDEN_LOCATION_ID);
+      }
+    }
+    // The serialized sheet a visitor receives contains no trace.
+    expect(JSON.stringify(sheet)).not.toContain(HIDDEN_ADDRESS);
+    expect(JSON.stringify(sheet)).not.toContain(HIDDEN_LOCATION_ID);
+  });
+
+  test("ATTACK 2: Ask FYD -> location discloses nothing", () => {
+    const answer = answerVisitorQuestion({
+      siteSlug: "coppersmith-plumbing",
+      objectId: COPPER_BUSINESS,
+      question: "Where is the business located? What is the street address?",
+      graph: hostileGraph(),
+    });
+    const serialized = JSON.stringify(answer);
+    expect(serialized).not.toContain(HIDDEN_ADDRESS);
+    expect(serialized).not.toContain(HIDDEN_LOCATION_ID);
+    expect(serialized).not.toContain("742 Hidden Lane");
+  });
+
+  test("ATTACK 3: search -> location finds nothing", () => {
+    const graph = hostileGraph();
+    const all = resolveQuery(
+      { kind: "all", schema: "ping.social.location@1" },
+      graph,
+      COPPER_BUSINESS,
+      VISITOR_VIEWER,
+    );
+    expect(all).toHaveLength(0);
+    const related = resolveQuery(
+      { kind: "related", from: COPPER_BUSINESS, predicate: "located_at" },
+      graph,
+      COPPER_BUSINESS,
+      VISITOR_VIEWER,
+    );
+    expect(related).toHaveLength(0);
+  });
+
+  test("ATTACK 4: no visible object traverses to the hidden location", () => {
+    const graph = hostileGraph();
+    for (const o of graph.objects) {
+      if (o.visibility !== "public") continue;
+      const sheet = buildObjectSheet(graph, o.id, VISITOR_VIEWER);
+      expect(sheet).not.toBeNull();
+      const serialized = JSON.stringify(sheet);
+      expect(serialized).not.toContain(HIDDEN_ADDRESS);
+      expect(serialized).not.toContain(HIDDEN_LOCATION_ID);
+    }
+  });
+
+  test("ATTACK 5: the why-this gate refuses the hidden object", () => {
+    const graph = hostileGraph();
+    const hidden = graph.objects.find((o) => o.id === HIDDEN_LOCATION_ID)!;
+    // This is exactly the check the /api/why-this route performs before
+    // calling the why lane. A hidden object fails closed here.
+    expect(canSee(hidden, VISITOR_VIEWER)).toBe(false);
+  });
+
+  test("CONTROL: the demo owner still sees the seam-labeled private state", () => {
+    // ADDRESS DECISION (locked): hiding is a visibility policy, never a
+    // deletion of the fact. The owner preview keeps the fact visible.
+    const sheet = buildObjectSheet(hostileGraph(), COPPER_BUSINESS, DEMO_OWNER);
+    expect(sheet).not.toBeNull();
+    const located = sheet!.edgeGroups.find((g) => g.predicate === "located_at");
+    expect(located).toBeDefined();
+    expect(
+      located!.items.some((i) => i.targetObjectId === HIDDEN_LOCATION_ID),
+    ).toBe(true);
+    const hidden = buildObjectSheet(hostileGraph(), HIDDEN_LOCATION_ID, DEMO_OWNER);
+    expect(hidden).not.toBeNull();
+    expect(JSON.stringify(hidden)).toContain(HIDDEN_ADDRESS);
+  });
+});
