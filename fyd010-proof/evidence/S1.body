<!DOCTYPE html><html lang="en" class="__variable_246ccd __variable_c29908 __variable_d59ba8 h-full antialiased" style="color-scheme:dark light"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" as="image" href="/fyd-media/db347abf5ab76b99822dd3d1f133c3ce683dc8499a0e719e39f10b08c9827b8b/blur-10w.webp"/><link rel="preload" as="image" href="/fyd-media/db347abf5ab76b99822dd3d1f133c3ce683dc8499a0e719e39f10b08c9827b8b/card-768w.webp"/><link rel="stylesheet" href="/_next/static/css/6e7b4dfc4271dafa.css" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/8c16ad0e9f252651.css" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/ef491f3d7ee87510.css" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/49f45562515fea30.css" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-ff12f876d312f53b.js"/><script src="/_next/static/chunks/4bd1b696-f785427dddbba9fb.js" async=""></script><script src="/_next/static/chunks/1255-5cd2fe06309409a0.js" async=""></script><script src="/_next/static/chunks/main-app-b22e697c38d35673.js" async=""></script><script src="/_next/static/chunks/2619-3c9e02e22d10480a.js" async=""></script><script src="/_next/static/chunks/4909-09e20765c3e2a673.js" async=""></script><script src="/_next/static/chunks/5754-2d5df74e6461794b.js" async=""></script><script src="/_next/static/chunks/8861-25acf2bf9ab41464.js" async=""></script><script src="/_next/static/chunks/7645-e30d28323fb3c929.js" async=""></script><script src="/_next/static/chunks/app/layout-e422d26c83857113.js" async=""></script><script src="/_next/static/chunks/app/sites/page-26d8446b1c861003.js" async=""></script><script src="/_next/static/chunks/1103-827da2cfd1d6a8b0.js" async=""></script><script src="/_next/static/chunks/7918-f003a5c972b25837.js" async=""></script><script src="/_next/static/chunks/7831-32a3c8676ced179a.js" async=""></script><script src="/_next/static/chunks/649-4f0fbd653ca2ef6b.js" async=""></script><script src="/_next/static/chunks/2722-70b89e109168344b.js" async=""></script><script src="/_next/static/chunks/6856-a973ddda9e1ab52c.js" async=""></script><script src="/_next/static/chunks/app/sites/coppersmith-plumbing/page-7151bd53eef6655e.js" async=""></script><meta name="next-size-adjust" content=""/><title>Coppersmith Plumbing - HVAC - Mechanical</title><meta name="description" content="Coppersmith Plumbing &amp; HVAC has serviced Western Colorado for over 25 years. With a proven track record of quality work and diverse skill sets, our team"/><meta name="generator" content="FYD Social"/><meta name="keywords" content="PING,AI agents,continuity,business automation,agent infrastructure,PING Social,TenantOS"/><link rel="canonical" href="https://ping.vercel.app/sites/coppersmith-plumbing"/><meta property="og:title" content="Coppersmith Plumbing - HVAC - Mechanical"/><meta property="og:description" content="Coppersmith Plumbing &amp; HVAC has serviced Western Colorado for over 25 years. With a proven track record of quality work and diverse skill sets, our team"/><meta property="og:url" content="https://ping.vercel.app/sites/coppersmith-plumbing"/><meta property="og:site_name" content="Coppersmith Plumbing - HVAC - Mechanical"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content="Coppersmith Plumbing - HVAC - Mechanical"/><meta name="twitter:description" content="Coppersmith Plumbing &amp; HVAC has serviced Western Colorado for over 25 years. With a proven track record of quality work and diverse skill sets, our team"/><link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16"/><link rel="icon" href="/brand/favicon.svg"/><link rel="apple-touch-icon" href="/brand/favicon.svg"/><script>
              (function() {
                const theme = localStorage.getItem('ping-theme');
                if (theme === 'dark') {
                  document.documentElement.classList.add('dark');
                } else {
                  document.documentElement.classList.remove('dark');
                }
              })();
            </script><script src="/_next/static/chunks/polyfills-42372ed130431b0a.js" noModule=""></script></head><body class="min-h-full flex flex-col bg-background"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg">Skip to main content</a><main id="main-content" class="flex-1"><main class="min-h-screen bg-background"><div><script>(function () {
  var SITE = "coppersmith-plumbing";
  var ATTENTION = 8;
  var EDGE_ENDPOINT = "/api/fyd/edge/object";
  var WHY_ENDPOINT = "/api/fyd/why-this";
  var ASK_ENDPOINT = "/api/fyd/ask";

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  // ---- sheet chrome (built once, lazily) ----
  var overlay = null, sheet = null, sheetScroll = null, sheetMain = null, live = null;
  var stack = [];
  var current = null;
  var triggerEl = null;
  var savedScrollY = 0;
  var fullNode = false;
  var revealed = {};

  function ensureChrome() {
    if (sheet) return;
    live = document.createElement("div");
    live.id = "fyd-edge-live";
    live.className = "fyd-sr-only";
    live.setAttribute("aria-live", "polite");
    document.body.appendChild(live);
    overlay = document.createElement("div");
    overlay.className = "fyd-edge-overlay";
    overlay.hidden = true;
    document.body.appendChild(overlay);
    sheet = document.createElement("section");
    sheet.id = "fyd-edge-sheet";
    sheet.className = "fyd-edge-sheet";
    sheet.setAttribute("role", "dialog");
    sheet.setAttribute("aria-modal", "false");
    sheet.setAttribute("aria-label", "Object details");
    sheet.hidden = true;
    sheet.innerHTML =
      "<div class=\"fyd-edge-grab\" aria-hidden=\"true\"></div>" +
      "<div class=\"fyd-edge-head\">" +
      "<div class=\"fyd-edge-backrow\">" +
      "<button type=\"button\" class=\"fyd-edge-back\" data-edge-nav=\"back\" hidden>Back</button>" +
      "<span class=\"fyd-edge-crumb\" aria-hidden=\"true\"></span>" +
      "<button type=\"button\" class=\"fyd-edge-close\" data-edge-nav=\"close\" aria-label=\"Close object details\">Close</button>" +
      "</div>" +
      "<div class=\"fyd-edge-titlewrap\"><h2 class=\"fyd-edge-title\" tabindex=\"-1\"></h2>" +
      "<p class=\"fyd-edge-type\"></p></div>" +
      "</div>" +
      "<div class=\"fyd-edge-scroll\"><div class=\"fyd-edge-main\"></div></div>";
    document.body.appendChild(sheet);
    sheetScroll = sheet.querySelector(".fyd-edge-scroll");
    sheetMain = sheet.querySelector(".fyd-edge-main");
    overlay.addEventListener("click", closeSheet);
    sheet.addEventListener("click", onSheetClick);
    sheet.addEventListener("submit", onSheetSubmit);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && sheet && !sheet.hidden) { closeSheet(); }
    });
  }

  function announce(msg) {
    if (live) live.textContent = msg;
  }

  function claimBadge(cc) {
    var labels = { DIRECT_FACT: "Website statement", DERIVED_FACT: "Derived", OWNER_AUTHORED: "Owner", GENERATED_COPY: "FYD copy" };
    var cls = { DIRECT_FACT: "cc-direct", DERIVED_FACT: "cc-derived", OWNER_AUTHORED: "cc-owner", GENERATED_COPY: "cc-generated" };
    return "<span class=\"fyd-claim fyd-claim-" + (cls[cc] || "cc-derived") + "\" title=\"Claim class: " + esc(cc) + "\">" + esc(labels[cc] || cc) + "</span>";
  }

  function kindTag(kind) {
    var map = { service_edge: "Service", location_edge: "Location", person_edge: "Person", business_edge: "Business", external_identity_edge: "Link", reference_edge: "Reference", generic_edge: "Related" };
    return "<span class=\"fyd-edge-tag fyd-kind-" + esc(kind) + "\">" + esc(map[kind] || "Related") + "</span>";
  }

  function actionHtml(a) {
    if (a.kind === "open_website" && a.href) {
      return "<a class=\"fyd-edge-action\" href=\"" + esc(a.href) + "\" target=\"_blank\" rel=\"noopener\">" + esc(a.label) + "</a>";
    }
    return "<button type=\"button\" class=\"fyd-edge-action\" data-edge-act=\"" + esc(a.kind) + "\">" + esc(a.label) + "</button>";
  }

  function groupHtml(g, data) {
    var shown = revealed[g.predicate] || ATTENTION;
    var items = g.items.slice(0, shown);
    var html = "<section class=\"fyd-edge-group\" data-edge-group=\"" + esc(g.predicate) + "\">";
    html += "<div class=\"fyd-edge-grouphead\"><h3>" + esc(g.label) + " <span class=\"fyd-edge-count\">" + g.totalCount + "</span></h3>";
    html += "<button type=\"button\" class=\"fyd-edge-why-g\" data-edge-why-group=\"" + esc(g.predicate) + "\" aria-expanded=\"false\">Why these?</button></div>";
    html += "<div class=\"fyd-edge-why-panel\" hidden></div>";
    html += "<ul class=\"fyd-edge-items\">";
    for (var i = 0; i < items.length; i++) {
      var it = items[i];
      html += "<li><button type=\"button\" class=\"fyd-edge-item\" data-edge-target=\"" + esc(it.targetObjectId) + "\" aria-label=\"" + esc(it.targetTitle) + ", " + esc(it.targetTypeLabel) + ". Open details.\">";
      html += kindTag(it.kind) + "<span class=\"fyd-edge-item-title\">" + esc(it.targetTitle) + "</span>";
      html += "<span class=\"fyd-edge-item-go\" aria-hidden=\"true\">&rsaquo;</span></button></li>";
    }
    html += "</ul>";
    if (g.totalCount > shown) {
      html += "<button type=\"button\" class=\"fyd-edge-more\" data-edge-more=\"" + esc(g.predicate) + "\" aria-expanded=\"false\">Show " + Math.min(ATTENTION, g.totalCount - shown) + " more</button>";
    }
    html += "</section>";
    return html;
  }

  function renderSheet(data) {
    ensureChrome();
    var titleEl = sheet.querySelector(".fyd-edge-title");
    var typeEl = sheet.querySelector(".fyd-edge-type");
    titleEl.textContent = data.title;
    typeEl.innerHTML = esc(data.typeLabel) + " " + claimBadge(data.summaryClaimClass);
    sheet.setAttribute("aria-label", data.title + " object details");
    var html = "<p class=\"fyd-edge-summary\">" + esc(data.summary) + "</p>";
    html += "<p class=\"fyd-edge-prov\">Source: " + esc(data.provenanceRef) + "</p>";

    if (fullNode) {
      html += "<section class=\"fyd-edge-claims\"><h3>Details</h3><dl>";
      for (var c = 0; c < data.claims.length; c++) {
        var cl = data.claims[c];
        html += "<div class=\"fyd-edge-claimrow\"><dt>" + esc(cl.label) + " " + claimBadge(cl.claimClass) + "</dt><dd>" + esc(cl.value) + "</dd></div>";
      }
      html += "</dl></section>";
      if (data.evidence && data.evidence.length) {
        html += "<section class=\"fyd-edge-evidence\"><h3>Evidence</h3><ul>";
        for (var e = 0; e < data.evidence.length; e++) {
          var ev = data.evidence[e];
          html += "<li><code>" + esc(ev.ref) + "</code><br><span>" + esc(ev.source) + " &middot; observed " + esc(ev.observedAt) + "</span></li>";
        }
        html += "</ul></section>";
      }
    }

    html += "<div class=\"fyd-edge-actions\">";
    for (var a = 0; a < data.actions.length; a++) { html += actionHtml(data.actions[a]); }
    html += "</div>";
    html += "<div class=\"fyd-edge-askpanel\" hidden>" +
      "<p class=\"fyd-edge-askctx\">Asking about <strong></strong></p>" +
      "<form class=\"fyd-edge-askform\"><label class=\"fyd-sr-only\" for=\"fyd-edge-askq\">Ask FYD</label>" +
      "<input id=\"fyd-edge-askq\" name=\"q\" type=\"text\" placeholder=\"Ask about this\" autocomplete=\"off\">" +
      "<button type=\"submit\">Ask</button></form>" +
      "<div class=\"fyd-edge-askresult\" aria-live=\"polite\"></div></div>";
    html += "<div class=\"fyd-edge-whypanel\" hidden></div>";

    if (!data.edgeGroups || !data.edgeGroups.length) {
      html += "<p class=\"fyd-edge-empty\">No related objects recorded for this entry.</p>";
    } else {
      for (var gi = 0; gi < data.edgeGroups.length; gi++) { html += groupHtml(data.edgeGroups[gi], data); }
    }
    sheetMain.innerHTML = html;
    var askCtx = sheetMain.querySelector(".fyd-edge-askctx strong");
    if (askCtx) askCtx.textContent = data.title;
    var askBtn = sheetMain.querySelector('[data-edge-act="ask"]');
    if (askBtn && !askBtn.hasAttribute("aria-expanded")) askBtn.setAttribute("aria-expanded", "false");
    var backBtn = sheet.querySelector(".fyd-edge-back");
    if (backBtn) backBtn.hidden = stack.length === 0;
    var crumb = sheet.querySelector(".fyd-edge-crumb");
    if (crumb) crumb.textContent = stack.length > 0 ? (stack.length + " deep") : "";
  }

  function showSheet() {
    ensureChrome();
    savedScrollY = window.scrollY || window.pageYOffset || 0;
    document.body.classList.add("fyd-edge-lock");
    overlay.hidden = false;
    sheet.hidden = false;
    if (sheetScroll) sheetScroll.scrollTop = 0;
    var closeBtn = sheet.querySelector(".fyd-edge-close");
    if (closeBtn) closeBtn.focus();
  }

  function hideSheet(restoreFocus) {
    if (triggerEl && triggerEl.setAttribute) triggerEl.setAttribute("aria-expanded", "false");
    if (!sheet || sheet.hidden) return;
    sheet.hidden = true;
    overlay.hidden = true;
    document.body.classList.remove("fyd-edge-lock");
    if (typeof savedScrollY === "number") window.scrollTo(0, savedScrollY);
    if (restoreFocus !== false && triggerEl && document.contains(triggerEl)) triggerEl.focus();
    current = null;
    stack = [];
    fullNode = false;
  }

  function openObject(objectId, trigger) {
    ensureChrome();
    if (triggerEl && triggerEl !== trigger && triggerEl.setAttribute) triggerEl.setAttribute("aria-expanded", "false");
    if (trigger) triggerEl = trigger;
    if (triggerEl && triggerEl.setAttribute) triggerEl.setAttribute("aria-expanded", "true");
    var url = EDGE_ENDPOINT + "?site=" + encodeURIComponent(SITE) +
      "&objectId=" + encodeURIComponent(objectId);
    announce("Loading details.");
    fetch(url).then(function (r) {
      if (!r.ok) throw new Error("not found");
      return r.json();
    }).then(function (data) {
      current = { objectId: objectId, data: data };
      revealed = {};
      renderSheet(data);
      showSheet();
      announce("Opened " + data.title + ". " + data.edgeGroups.length + " relationship groups.");
    }).catch(function () {
      announce("That entry is not available.");
    });
  }

  // Published so the site client can route /o/ link taps into the same
  // sheet instead of a second, competing overlay.
  window.__fydEdgeOpen = openObject;

  function traverse(targetId) {
    if (!current) return;
    stack.push({ objectId: current.objectId, data: current.data, scrollY: savedScrollY });
    fullNode = false;
    openObject(targetId, null);
  }

  function goBack() {
    var prev = stack.pop();
    if (!prev) { closeSheet(); return; }
    ensureChrome();
    fullNode = false;
    revealed = {};
    current = { objectId: prev.objectId, data: prev.data };
    renderSheet(prev.data);
    savedScrollY = prev.scrollY;
    document.body.classList.add("fyd-edge-lock");
    overlay.hidden = false;
    sheet.hidden = false;
    if (sheetScroll) sheetScroll.scrollTop = 0;
    announce("Back to " + prev.data.title + ".");
  }

  function closeSheet() { hideSheet(true); }

  function toggleAsk(btn) {
    var panel = sheetMain.querySelector(".fyd-edge-askpanel");
    if (!panel) return;
    panel.hidden = !panel.hidden;
    if (btn) btn.setAttribute("aria-expanded", panel.hidden ? "false" : "true");
    if (!panel.hidden) {
      var input = panel.querySelector("input");
      if (input) input.focus();
    }
  }

  function toggleWhyObject() {
    var panel = sheetMain.querySelector(".fyd-edge-whypanel");
    if (!panel || !current) return;
    if (!panel.hidden) { panel.hidden = true; return; }
    panel.hidden = false;
    panel.innerHTML = "<p>Checking the evidence...</p>";
    var url = WHY_ENDPOINT + "?siteId=" + encodeURIComponent(SITE) +
      "&objectId=" + encodeURIComponent(current.objectId);
    fetch(url).then(function (r) { return r.json(); }).then(function (w) {
      if (!w.found) { panel.innerHTML = "<p class=\"fyd-fail\">" + esc(w.reason) + "</p>"; return; }
      panel.innerHTML = "<dl class=\"fyd-why-dl\">" +
        "<dt>Source</dt><dd>" + esc(w.source) + "</dd>" +
        "<dt>Observed value</dt><dd>" + esc(w.observedValue) + "</dd>" +
        "<dt>Observation time</dt><dd>" + esc(w.observationTime) + "</dd>" +
        "<dt>Extraction method</dt><dd>" + esc(w.extractionMethod) + "</dd></dl>";
    }).catch(function () { panel.innerHTML = "<p class=\"fyd-fail\">Could not load evidence.</p>"; });
  }

  function toggleWhyGroup(btn) {
    var section = btn.closest(".fyd-edge-group");
    if (!section || !current) return;
    var panel = section.querySelector(".fyd-edge-why-panel");
    if (!panel) return;
    var open = panel.hidden;
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    if (!open) { panel.hidden = true; return; }
    panel.hidden = false;
    var predicate = btn.getAttribute("data-edge-why-group");
    var first = null;
    for (var gi = 0; gi < current.data.edgeGroups.length; gi++) {
      var g = current.data.edgeGroups[gi];
      if (g.predicate === predicate && g.items.length) { first = g.items[0]; break; }
    }
    if (!first) { panel.innerHTML = "<p class=\"fyd-fail\">No edge recorded.</p>"; return; }
    panel.innerHTML = "<p>Checking the evidence...</p>";
    var url = WHY_ENDPOINT + "?siteId=" + encodeURIComponent(SITE) +
      "&objectId=" + encodeURIComponent(first.targetObjectId) +
      "&field=" + encodeURIComponent(predicate);
    fetch(url).then(function (r) { return r.json(); }).then(function (w) {
      if (!w.found) { panel.innerHTML = "<p class=\"fyd-fail\">" + esc(w.reason) + "</p>"; return; }
      panel.innerHTML = "<dl class=\"fyd-why-dl\">" +
        "<dt>Source</dt><dd>" + esc(w.source) + "</dd>" +
        "<dt>Observed value</dt><dd>" + esc(w.observedValue) + "</dd>" +
        "<dt>Observation time</dt><dd>" + esc(w.observationTime) + "</dd>" +
        "<dt>Extraction method</dt><dd>" + esc(w.extractionMethod) + "</dd></dl>";
    }).catch(function () { panel.innerHTML = "<p class=\"fyd-fail\">Could not load evidence.</p>"; });
  }

  function onSheetClick(e) {
    var nav = e.target.closest("[data-edge-nav]");
    if (nav) { if (nav.getAttribute("data-edge-nav") === "back") goBack(); else closeSheet(); return; }
    var more = e.target.closest("[data-edge-more]");
    if (more) {
      var pred = more.getAttribute("data-edge-more");
      revealed[pred] = (revealed[pred] || ATTENTION) + ATTENTION;
      var expanded = more.getAttribute("aria-expanded") === "true";
      more.setAttribute("aria-expanded", expanded ? "false" : "true");
      if (current) renderSheet(current.data);
      return;
    }
    var whyG = e.target.closest("[data-edge-why-group]");
    if (whyG) { toggleWhyGroup(whyG); return; }
    var act = e.target.closest("[data-edge-act]");
    if (act) {
      var kind = act.getAttribute("data-edge-act");
      if (kind === "ask") { toggleAsk(act); return; }
      if (kind === "why_this") { toggleWhyObject(); return; }
      if (kind === "open_full_node") {
        fullNode = !fullNode;
        var fnBtn = sheetMain.querySelector('[data-edge-act="open_full_node"]');
        if (fnBtn) fnBtn.textContent = fullNode ? "Compact view" : "Open full node";
        if (current) renderSheet(current.data);
        return;
      }
      if (kind === "reference") {
        var text = "FYD object " + current.objectId + " (" + current.data.title + ")";
        announce("Reference copied.");
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(function () {});
        }
        return;
      }
      return;
    }
    var tgt = e.target.closest("[data-edge-target]");
    if (tgt) { traverse(tgt.getAttribute("data-edge-target")); return; }
  }

  function onSheetSubmit(e) {
    var form = e.target.closest(".fyd-edge-askform");
    if (!form || !current) return;
    e.preventDefault();
    var input = form.querySelector("input");
    var result = sheetMain.querySelector(".fyd-edge-askresult");
    var q = input.value.trim();
    if (!q || !result) return;
    result.innerHTML = "<p>Asking FYD...</p>";
    fetch(ASK_ENDPOINT, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ siteId: SITE, question: q, objectId: current.objectId }),
    }).then(function (r) { return r.json(); }).then(function (a) {
      var html = "<p><strong>Answer:</strong> " + esc(a.answer) + "</p>";
      if (a.citations && a.citations.length) {
        html += "<p class=\"fyd-edge-evh\">Evidence</p><ul class=\"fyd-evidence-list\">";
        a.citations.forEach(function (c) {
          html += "<li>[" + c.n + "] " + esc(c.label) + " &middot; " + esc(c.basis) + "</li>";
        });
        html += "</ul>";
      }
      if (a.unknowns && a.unknowns.length) {
        html += "<p class=\"fyd-unknowns\"><strong>Not established by the evidence:</strong> " + a.unknowns.map(esc).join("; ") + "</p>";
      }
      if (a.refusal) html += "<p><em>FYD could not answer that.</em></p>";
      result.innerHTML = html;
    }).catch(function () { result.innerHTML = "<p class=\"fyd-fail\">Something went wrong asking FYD.</p>"; });
  }

  // ---- tap-to-expand: every rendered object binding is a doorway ----
  document.addEventListener("click", function (e) {
    if (sheet && !sheet.hidden && e.target.closest("#fyd-edge-sheet")) return;
    if (e.target.closest(".why-this-btn")) return;
    if (e.target.closest(".why-this-panel")) return;
    if (e.target.closest("a, button")) return;
    var binding = e.target.closest("[data-fyd-object-id]");
    if (!binding) return;
    var id = binding.getAttribute("data-fyd-object-id");
    if (!id) return;
    e.preventDefault();
    openObject(id, binding);
  });

  // ---- keyboard: cards and circles open with Enter/Space ----
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Enter" && e.key !== " ") return;
    var t = e.target;
    if (!t || !t.getAttribute) return;
    if (!t.hasAttribute("data-fyd-object-id")) return;
    if (e.target.closest(".why-this-btn")) return;
    e.preventDefault();
    openObject(t.getAttribute("data-fyd-object-id"), t);
  });

  // ---- mark bindings operable (no visual change) ----
  function markBindings() {
    document.querySelectorAll("[data-fyd-object-id]").forEach(function (el) {
      el.setAttribute("aria-expanded", el.getAttribute("aria-expanded") || "false");
      if (el.hasAttribute("tabindex")) return;
      el.setAttribute("tabindex", "0");
      el.setAttribute("role", "button");
      el.setAttribute("aria-label", (el.querySelector("h3") || {}).textContent || el.textContent || "object");
    });
  }
  // Post-hydration only: mutating React-managed DOM before/during
  // hydration causes hydration mismatches. Defer to window load.
  function scheduleMarkBindings() {
    if (document.readyState === "complete") {
      markBindings();
    } else {
      window.addEventListener("load", markBindings);
    }
  }
  scheduleMarkBindings();
})();
