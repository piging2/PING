+    return NextResponse.json(
+      { error: "Resource download not configured" },
+      { status: 503 }
+    );
+  }
+  if (!bearerTokenValid(request, token)) {
+    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  }
