+function verifySignature(
+  rawBody: string,
+  signatureHeader: string,
+  secret: string
+): boolean {
+  if (!signatureHeader.startsWith("sha256=")) {
+    return false;
+  }
+  const provided = Buffer.from(signatureHeader.slice("sha256=".length), "utf8");
+  const expectedHex = createHmac("sha256", secret)
