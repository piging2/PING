index 0000000..6958f38
--- /dev/null
+++ b/src/tenanos/tenant/bridge-tenant.ts
@@ -0,0 +1,72 @@
+/**
+ * Tenant propagation for the canonical -> spine event bridge.
+ *
+ * Problem (proven 2026-09-23, swarm-01): EventBridge._bridgeCanonicalEvents
+ * reads tenant_id from canonical_events, stashes it in payload._tenant_id and
+ * metadata.tenant_id, then calls UnifiedEventRuntime.emit WITHOUT options.namespace.
+ * UnifiedEventRuntime.emit resolves `options.namespace || 'core::system'`, so
+ * every bridged tenant event is re-namespaced to core::system: system-namespace
+ * laundering. Downstream (event->mission bridge, scheduler, workers) then
+ * faithfully preserves the WRONG namespace via payload.namespace / BaseWorker._emit.
+ *
+ * This module derives the emit options the bridge must pass so the tenant
+ * survives as the enforced namespace, not just as inert metadata.
+ *
+ * Unknown-tenant policy: when row.tenant_id is null/empty the bridge cannot
+ * invent a tenant. It keeps the 'core::system' default (current behavior) but
+ * tags metadata.tenant_unknown=true so the laundering is OBSERVABLE instead
+ * of silent. A fail-closed refusal here would wedge the background worker;
+ * observability is the correct worker posture.
+ */
+
+import { tenantIdToNamespace, NAMESPACE_RE } from './tenant-context';
+
+export const SYSTEM_NAMESPACE = 'core::system';
+
+export interface TenantNamespaceResolution {
+  namespace: string;
+  tenantUnknown: boolean;
+}
+
+/**
+ * Map a canonical_events tenant_id value to the enforced namespace.
+ * Accepts both the canonical 'tenant::<slug>' form and a bare slug.
+ */
+export function namespaceForTenantId(tenantId: unknown): TenantNamespaceResolution {
+  if (tenantId === null || tenantId === undefined || tenantId === '') {
+    return { namespace: SYSTEM_NAMESPACE, tenantUnknown: true };
+  }
+  const raw = String(tenantId);
+  if (NAMESPACE_RE.test(raw)) return { namespace: raw, tenantUnknown: false };
+  try {
+    return { namespace: tenantIdToNamespace(raw), tenantUnknown: false };
+  } catch {
+    return { namespace: SYSTEM_NAMESPACE, tenantUnknown: true };
+  }
+}
+
+export interface CanonicalEventRow {
+  tenant_id: unknown;
+}
+
+export interface EmitBaseOptions {
+  metadata?: Record<string, unknown>;
+  [key: string]: unknown;
+}
+
+/**
+ * Build the options object for UnifiedEventRuntime.emit from a canonical_events
+ * row, preserving the tenant as the enforced namespace.
+ *
+ * Integration (event_bridge.js, _bridgeCanonicalEvents): pass the returned
+ * `namespace` into the existing emit options object alongside _skipGovernance.
+ */
+export function emitOptionsForCanonicalRow<TBase extends EmitBaseOptions>(
+  row: CanonicalEventRow,
+  baseOptions: TBase = {} as TBase,
+): TBase & { namespace: string; metadata: Record<string, unknown> } {
+  const { namespace, tenantUnknown } = namespaceForTenantId(row.tenant_id);
+  const metadata: Record<string, unknown> = { ...(baseOptions.metadata ?? {}) };
+  if (tenantUnknown) metadata.tenant_unknown = true;
+  return { ...baseOptions, namespace, metadata };
+}

diff --git a/src/tenanos/tenant/tenant-scope.ts b/src/tenanos/tenant/tenant-scope.ts
new file mode 100644
index 0000000..3c6c046
--- /dev/null
+++ b/src/tenanos/tenant/tenant-scope.ts
@@ -0,0 +1,82 @@
+/**
+ * Tenant scoping helpers for substrate read paths.
+ *
+ * Backend half of the P-20260923-088 contract (swarm-08 PROJECTION-WIRING.md):
+ * the 088 spec requires every projection query to take a resolved tenant_id
+ * and enforce it (default-deny on the event query; tenant_id column or
+ * payload->>'namespace' scoping on missions; namespace passed to knowledge
+ * queries). These helpers give every read path the same predicate
+ * construction. They are additive: query builders keep ownership of their
+ * SQL; they just append the clause produced here.
+ *
+ * Interim mission filtering reads payload._tenant_id (written by the bridge
+ * today) until a tenant_id column lands on ping_missions.
+ */
+
+import {
+  tenantIdToNamespace,
+  requireTenantContext,
+  TenantContext,
+} from './tenant-context';
+
+export interface SqlPredicate {
+  clause: string;
+  params: string[];
+}
+
+/**
+ * SQL predicate for namespace-scoped tables (ping_events).
+ * e.g. { clause: 'namespace = $3', params: ['tenant::acme'] }
+ */
+export function namespacePredicate(ctx: unknown, paramIndex = 1): SqlPredicate {
+  const c: TenantContext = requireTenantContext(ctx);
+  return { clause: `namespace = $${paramIndex}`, params: [c.namespace] };
+}
+
+/**
+ * SQL predicate for tenant_id-column tables (canonical_events).
+ */
+export function tenantIdPredicate(ctx: unknown, paramIndex = 1): SqlPredicate {
+  const c: TenantContext = requireTenantContext(ctx);
+  return { clause: `tenant_id = $${paramIndex}`, params: [c.tenantId] };
+}
+
+export interface MissionRow {
+  mission_id?: string;
+  payload?: unknown;
+}
+
+/**
+ * Interim in-memory filter for ping_missions rows whose tenant survives only
+ * as payload._tenant_id. Rows with no tenant marker are treated as SYSTEM
+ * scope and are visible only to a system (non-tenant) caller, never to a
+ * tenant caller. Throws on cross-tenant access instead of returning [].
+ */
+export function filterMissionsByTenant(
+  missions: MissionRow[] | null | undefined,
+  ctx: unknown,
+): MissionRow[] {
+  const c: TenantContext = requireTenantContext(ctx);
+  const wanted = tenantIdToNamespace(c.tenantId);
+  return (missions ?? []).filter((m) => {
+    let payload: unknown = m.payload;
+    if (typeof payload === 'string') {
+      try {
+        payload = JSON.parse(payload);
+      } catch {
+        payload = {};
+      }
+    }
+    const record =
+      payload !== null && typeof payload === 'object'
+        ? (payload as Record<string, unknown>)
+        : {};
+    const marker = record._tenant_id ?? record.tenant_id;
+    if (marker === undefined || marker === null || marker === '') return false; // unmarked missions are system scope: invisible to tenants
+    const markerStr = String(marker);
+    const ns = markerStr.startsWith('tenant::')
+      ? markerStr
+      : tenantIdToNamespace(markerStr);
+    return ns === wanted;
+  });
+}

diff --git a/src/tenanos/__tests__/tenant-kit.test.ts b/src/tenanos/__tests__/tenant-kit.test.ts
new file mode 100644
index 0000000..5a48d57
--- /dev/null
+++ b/src/tenanos/__tests__/tenant-kit.test.ts
@@ -0,0 +1,149 @@
+/**
+ * Tenant boundary kit tests (swarm-01).
+ * Runs under the scoped substrate config src/tenanos/jest.config.cjs
+ * (testEnvironment node, ts-jest strict). Covers the additive kit only; the
+ * attack scripts in ~/workspace/tenanos-wave/swarm-01/tests cover the existing
+ * substrate code paths this kit hardens.
+ */
+import { describe, test, expect } from '@jest/globals';
+import {
+  TENANT_SLUG_PATTERN,
+  TenantBoundaryError,
+  tenantIdToNamespace,
+  namespaceToTenantId,
+  bindTenantContext,
+  requireTenantContext,
+  assertSameTenant,
+} from '../tenant/tenant-context';
+import { createNamespaceBinder } from '../tenant/namespace-binding';
+import {
+  namespaceForTenantId,
+  emitOptionsForCanonicalRow,
+} from '../tenant/bridge-tenant';
+import {
+  namespacePredicate,
+  tenantIdPredicate,
+  filterMissionsByTenant,
+} from '../tenant/tenant-scope';
+
+describe('tenant-context', () => {
+  test('canonical mapping tenant slug <-> namespace', () => {
+    expect(tenantIdToNamespace('acme')).toBe('tenant::acme');
+    expect(namespaceToTenantId('tenant::acme')).toBe('acme');
+    expect(namespaceToTenantId('core::system')).toBeNull();
+    expect(TENANT_SLUG_PATTERN.test('acme')).toBe(true);
+  });
+  test('invalid slugs fail closed', () => {
+    expect(() => tenantIdToNamespace('ACME')).toThrow(TenantBoundaryError);
+    expect(() => tenantIdToNamespace('../../etc')).toThrow(TenantBoundaryError);
+    expect(() => tenantIdToNamespace('')).toThrow(TenantBoundaryError);
+  });
+  test('bind/require round-trip; tampered context refused', () => {
+    const ctx = bindTenantContext({ tenantId: 'acme', actorId: 'op-1' });
+    expect(requireTenantContext(ctx).tenantId).toBe('acme');
+    expect(() => requireTenantContext(null)).toThrow(TenantBoundaryError);
+    expect(() =>
+      requireTenantContext({ ...ctx, namespace: 'tenant::victim' }),
+    ).toThrow(TenantBoundaryError);
+  });
+  test('assertSameTenant refuses cross-tenant, never empty', () => {
+    const ctx = bindTenantContext({ tenantId: 'acme' });
+    expect(assertSameTenant(ctx, 'acme').tenantId).toBe('acme');
+    expect(() => assertSameTenant(ctx, 'victim')).toThrow(TenantBoundaryError);
+    try {
+      assertSameTenant(ctx, 'victim');
+      throw new Error('should have thrown');
+    } catch (e) {
+      expect((e as TenantBoundaryError).code).toBe('CROSS_TENANT_REFERENCE');
+    }
+  });
+});
+
+describe('namespace-binding', () => {
+  test('unbound explicit override is DENIED (the honor-system fix)', () => {
+    const binder = createNamespaceBinder({
+      bindings: { 'review-emitter': ['tenant::acme'] },
+    });
+    const denied = binder.authorize('attacker-source', 'tenant::victim');
+    expect(denied.authorized).toBe(false);
+    expect(denied.reason).toMatch(/not bound/);
+  });
+  test('bound override allowed; per-source default; global default', () => {
+    const binder = createNamespaceBinder({
+      bindings: { 'review-emitter': ['tenant::acme'] },
+    });
+    expect(binder.authorize('review-emitter', 'tenant::acme')).toEqual({
+      authorized: true,
+      namespace: 'tenant::acme',
+    });
+    expect(binder.authorize('review-emitter')).toEqual({
+      authorized: true,
+      namespace: 'tenant::acme',
+    });
+    expect(binder.authorize('unknown-source')).toEqual({
+      authorized: true,
+      namespace: 'core::owner',
+    });
+  });
+  test('malformed namespace denied, not coerced', () => {
+    const binder = createNamespaceBinder({});
+    expect(binder.authorize('s', 'not a namespace').authorized).toBe(false);
+  });
+  test('bindSourceToTenant maps slug to canonical namespace', () => {
+    const binder = createNamespaceBinder({});
+    binder.bindSourceToTenant('billing-emitter', 'acme');
+    expect(binder.authorize('billing-emitter', 'tenant::acme').authorized).toBe(
+      true,
+    );
+    expect(binder.authorize('billing-emitter', 'tenant::victim').authorized).toBe(
+      false,
+    );
+  });
+});
+
+describe('bridge-tenant', () => {
+  test('canonical row tenant_id becomes enforced namespace', () => {
+    const opts = emitOptionsForCanonicalRow(
+      { tenant_id: 'tenant::acme' },
+      { _skipGovernance: true },
+    );
+    expect(opts.namespace).toBe('tenant::acme');
+    expect(opts._skipGovernance).toBe(true);
+    expect(opts.metadata.tenant_unknown).toBeUndefined();
+  });
+  test('bare slug tenant_id is canonicalized', () => {
+    expect(namespaceForTenantId('acme').namespace).toBe('tenant::acme');
+  });
+  test('unknown tenant stays system-scoped but OBSERVABLE', () => {
+    const opts = emitOptionsForCanonicalRow({ tenant_id: null }, {});
+    expect(opts.namespace).toBe('core::system');
+    expect(opts.metadata.tenant_unknown).toBe(true);
+  });
+});
+
+describe('tenant-scope', () => {
+  const ctx = bindTenantContext({ tenantId: 'acme' });
+  test('predicates build the right clauses', () => {
+    expect(namespacePredicate(ctx, 3)).toEqual({
+      clause: 'namespace = $3',
+      params: ['tenant::acme'],
+    });
+    expect(tenantIdPredicate(ctx, 2)).toEqual({
+      clause: 'tenant_id = $2',
+      params: ['acme'],
+    });
+  });
+  test('mission filter keeps own tenant, drops others and unmarked', () => {
+    const missions = [
+      { mission_id: 'm1', payload: JSON.stringify({ _tenant_id: 'tenant::acme' }) },
+      { mission_id: 'm2', payload: JSON.stringify({ _tenant_id: 'tenant::victim' }) },
+      { mission_id: 'm3', payload: JSON.stringify({}) },
+    ];
+    const kept = filterMissionsByTenant(missions, ctx);
+    expect(kept.map((m) => m.mission_id)).toEqual(['m1']);
+  });
+  test('scope helpers fail closed without context', () => {
+    expect(() => namespacePredicate(null)).toThrow(TenantBoundaryError);
+    expect(() => filterMissionsByTenant([], null)).toThrow(TenantBoundaryError);
+  });
+});
