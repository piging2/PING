index 0000000..25e6bdb
--- /dev/null
+++ b/src/tenanos/decision-budget/taxonomy.ts
@@ -0,0 +1,185 @@
+/**
+ * Decision-budget taxonomy — Swarm 10 (Human Decision Budget).
+ *
+ * Pure classification module. No I/O, no stores, no event bus, no authority.
+ * It answers one question: for an attempted escalation, WHO decides next —
+ * the agent (classes AUTO_*) or a human (classes HUMAN_*) — and why.
+ *
+ * Membership tests are evaluated in enum order; the FIRST passing test wins.
+ * Auto classes take precedence by construction: that precedence IS the budget.
+ */
+
+export enum EscalationClass {
+  // Auto-resolve: MUST NOT reach a human.
+  DERIVABLE_FROM_SOURCE = 'DERIVABLE_FROM_SOURCE',
+  DERIVABLE_FROM_HISTORY = 'DERIVABLE_FROM_HISTORY',
+  DERIVABLE_FROM_RUNTIME = 'DERIVABLE_FROM_RUNTIME',
+  SAFE_EXPERIMENT_AVAILABLE = 'SAFE_EXPERIMENT_AVAILABLE',
+  // Human-eligible: exactly-once, minimum payload (see escalation-envelope.ts).
+  CREDENTIAL_REQUIRED = 'CREDENTIAL_REQUIRED',
+  AUTHORIZATION_REQUIRED = 'AUTHORIZATION_REQUIRED',
+  DESTRUCTIVE = 'DESTRUCTIVE',
+  PRODUCT_INTENT = 'PRODUCT_INTENT',
+  POLICY_CONFLICT = 'POLICY_CONFLICT',
+  OTHER = 'OTHER',
+}
+
+export const AUTO_CLASSES: ReadonlySet<EscalationClass> = new Set([
+  EscalationClass.DERIVABLE_FROM_SOURCE,
+  EscalationClass.DERIVABLE_FROM_HISTORY,
+  EscalationClass.DERIVABLE_FROM_RUNTIME,
+  EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+]);
+
+export function isAutoClass(c: EscalationClass): boolean {
+  return AUTO_CLASSES.has(c);
+}
+
+/**
+ * The evidence an escalation attempt carries. Built by the caller (the converged
+ * loop) from existing sources — approval_conditions, gate output, DLQ rows,
+ * scheduler state — at the exact hook site. Nothing here is fetched.
+ */
+export interface EscalationAttempt {
+  /** Stable hook-site id, e.g. 'E-07'. See hook-points.ts. */
+  siteId: string;
+  /** mission / run / execution / approval / dead-letter ids, as applicable. */
+  contextIds: Record<string, string>;
+  /** Machine-readable cause, e.g. approval_conditions.blocked_by. */
+  causeCode?: string;
+  /** Human-readable what-happened, one line. */
+  summary: string;
+  /**
+   * What the agent already tried, in order. Required (may be empty only for
+   * CREDENTIAL_REQUIRED / PRODUCT_INTENT where asking first is correct).
+   */
+  priorAttempts: Array<{
+    action: string;
+    sourceConsulted?: string;
+    outcome: string;
+    at: string;
+  }>;
+  /** Signals the caller observed; predicates read these, never I/O. */
+  signals: {
+    /** The blocking artifact names a deterministic remedy (gate hint, validator output). */
+    causeNamesRemedy?: boolean;
+    /** ≥1 prior attempt with the same repeatKey reached a terminal recorded resolution. */
+    historyHasRecordedResolution?: boolean;
+    /** Consecutive failures for this repeatKey with no successful resolution. */
+    consecutiveFailures?: number;
+    /** Answer is observable from live scheduler/registry/queue/table state. */
+    answerInLiveState?: boolean;
+    /** A bounded, sandboxed, evidence-recorded experiment exists. */
+    safeExperimentAvailable?: boolean;
+    /** Progress impossible without a human-provisioned secret/config. */
+    needsProvisionedSecret?: boolean;
+    /** Policy or design requires a named human yes/no. */
+    requiresHumanJudgment?: boolean;
+    /** Effect is irreversible. */
+    irreversible?: boolean;
+    /** No source/history/runtime/experiment could answer; it is a want, not a fact. */
+    isWantNotFact?: boolean;
+    /** Standing rules contradict, or the rule is unwired. */
+    policyContradiction?: string;
+  };
+  /** sha256(siteId|class|mission_type|target|blocked_by|failure_reason) — caller computes. */
+  repeatKey: string;
+  /** True when a prior attempt with this repeatKey reached a human in the last 24h. */
+  isRepeat?: boolean;
+}
+
+export interface Classification {
+  class: EscalationClass;
+  /** The membership test that passed, quoted. */
+  rationale: string;
+  autoResolve: boolean;
+  /** For repeats: what changed since the prior decision, if anything. */
+  repeatNote?: string;
+}
+
+const q = (s: string) => `"${s}"`;
+
+/**
+ * Classify an escalation attempt. Pure: reads only the attempt.
+ * Order below is normative (DECISION-BUDGET.md section 2).
+ */
+export function classify(attempt: EscalationAttempt): Classification {
+  const s = attempt.signals;
+
+  if (s.causeNamesRemedy) {
+    return {
+      class: EscalationClass.DERIVABLE_FROM_SOURCE,
+      rationale: `cause ${q(attempt.causeCode ?? 'unknown')} names its own remedy; fix deterministically and re-verify (R1).`,
+      autoResolve: true,
+    };
+  }
+  if (s.historyHasRecordedResolution && (s.consecutiveFailures ?? 0) < 3) {
+    return {
+      class: EscalationClass.DERIVABLE_FROM_HISTORY,
+      rationale: `repeatKey ${q(attempt.repeatKey.slice(0, 12))} has a recorded terminal resolution; replay it (R2).`,
+      autoResolve: true,
+    };
+  }
+  if ((s.consecutiveFailures ?? 0) >= 3 && s.safeExperimentAvailable) {
+    return {
+      class: EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+      rationale: `history shows >=3 consecutive failures; stop replaying, run one bounded experiment (R2/R4).`,
+      autoResolve: true,
+    };
+  }
+  if (s.answerInLiveState) {
+    return {
+      class: EscalationClass.DERIVABLE_FROM_RUNTIME,
+      rationale: `answer observable from live state; read fresh, act, re-check (R1/R2).`,
+      autoResolve: true,
+    };
+  }
+  if (s.safeExperimentAvailable) {
+    return {
+      class: EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+      rationale: `bounded dry-run available: side-effect-free or sandboxed, time-bounded, evidence-recorded (2.4).`,
+      autoResolve: true,
+    };
+  }
+  if (s.needsProvisionedSecret) {
+    return {
+      class: EscalationClass.CREDENTIAL_REQUIRED,
+      rationale: `progress impossible without a human-provisioned value no agent may mint.`,
+      autoResolve: false,
+    };
+  }
+  if (s.irreversible) {
+    return {
+      class: EscalationClass.DESTRUCTIVE,
+      rationale: `effect is irreversible; approval gate makes "yes" cheap, not theatrical.`,
+      autoResolve: false,
+    };
+  }
+  if (s.requiresHumanJudgment) {
+    return {
+      class: EscalationClass.AUTHORIZATION_REQUIRED,
+      rationale: `policy or design requires a named human decision; the question is a real judgment.`,
+      autoResolve: false,
+    };
+  }
+  if (s.isWantNotFact) {
+    return {
+      class: EscalationClass.PRODUCT_INTENT,
+      rationale: `no source/history/runtime/experiment answers it; route to the one canonical surface.`,
+      autoResolve: false,
+    };
+  }
+  if (s.policyContradiction) {
+    return {
+      class: EscalationClass.POLICY_CONFLICT,
+      rationale: `policy conflict or unwired rule: ${q(s.policyContradiction)}; fail closed, escalate the conflict once.`,
+      autoResolve: false,
+    };
+  }
+  return {
+    class: EscalationClass.OTHER,
+    rationale: `no class test passed; burden of proof is on escalation — state why 2.1-2.4 do not apply.`,
+    autoResolve: false,
+    repeatNote: attempt.isRepeat ? 'repeat without recorded decision change' : undefined,
+  };
+}
diff --git a/src/tenanos/decision-budget/auto-resolvers.ts b/src/tenanos/decision-budget/auto-resolvers.ts
new file mode 100644
index 0000000..4b5254e
--- /dev/null
+++ b/src/tenanos/decision-budget/auto-resolvers.ts
@@ -0,0 +1,185 @@
+/**
+ * Auto-resolvers — Swarm 10 (Human Decision Budget).
+ *
+ * How agents resolve the four auto classes THEMSELVES (DECISION-BUDGET.md R1-R5).
+ * These are contracts + bounded procedures, not implementations: the converged
+ * loop supplies the source readers; the resolvers enforce the bounds.
+ *
+ * An agent that cannot name the source it consulted has not auto-resolved.
+ */
+
+import { EscalationAttempt, EscalationClass } from './taxonomy';
+
+export interface ResolutionResult {
+  resolved: boolean;
+  /** What was done, in audit-ready language. Appended to the evidence chain (R3). */
+  actionTaken: string;
+  /** The source consulted, named (R1). */
+  sourceConsulted: string;
+  /** Follow-up class when not resolved (e.g. experiment failed -> human with evidence). */
+  reclassifyTo?: EscalationClass;
+  /** Evidence produced (experiment output, re-verification result, state snapshot ref). */
+  evidence?: string;
+}
+
+/** Bounds from DECISION-BUDGET.md R2. */
+export const RESOLUTION_BOUNDS = {
+  /** 2.1: one fix + one re-verification per distinct blocked_by. */
+  maxFixAttemptsPerCause: 1,
+  /** 2.2: replay at most one recorded resolution. */
+  maxHistoryReplays: 1,
+  /** 2.3: re-check at most N times with backoff, then convert to experiment. */
+  maxRuntimeRechecks: 3,
+  /** 2.4: one experiment per hypothesis. */
+  maxExperimentsPerHypothesis: 1,
+  /** History replay stops after this many consecutive failures. */
+  consecutiveFailureCap: 3,
+  /** Default sandbox experiment budget. */
+  experimentTimeoutMs: 5 * 60 * 1000,
+} as const;
+
+/**
+ * 2.1 DERIVABLE_FROM_SOURCE — apply the remedy the artifact names, re-verify
+ * through the same gate. Concrete remedy map from the inventory:
+ *  - 'tests_failed'            -> re-run the failing tests (E-01/E-07)
+ *  - 'patch_validation_failed' -> read validator output, amend patch (E-01/E-07)
+ *  - 'replay_mismatch'         -> re-run replay; if flaky, one re-run only (E-01/E-07)
+ *  - 'witness_verification_failed' -> re-create witness (E-01)
+ *  - merge-gate hint           -> apply the hinted fix (E-10)
+ *  - 'no worker matched'       -> registry lookup; register worker or drop type (E-21)
+ *  - TRANSITION_BLOCKED        -> follow an allowed transition (E-28)
+ */
+export interface SourceResolver {
+  /** The blocked_by / gate id / cause code being resolved. */
+  causeCode: string;
+  /** Apply the deterministic remedy. Must be side-effect-bounded. */
+  applyFix(attempt: EscalationAttempt): Promise<{ fixed: boolean; detail: string }>;
+  /** Re-verify through the SAME gate that blocked. */
+  reverify(attempt: EscalationAttempt): Promise<{ passed: boolean; detail: string }>;
+}
+
+export async function resolveFromSource(
+  attempt: EscalationAttempt,
+  resolver: SourceResolver,
+): Promise<ResolutionResult> {
+  const fix = await resolver.applyFix(attempt);
+  if (!fix.fixed) {
+    return {
+      resolved: false,
+      actionTaken: `source remedy for ${resolver.causeCode} could not be applied: ${fix.detail}`,
+      sourceConsulted: `blocking artifact (${attempt.siteId})`,
+      reclassifyTo: EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+      evidence: fix.detail,
+    };
+  }
+  const check = await resolver.reverify(attempt);
+  return {
+    resolved: check.passed,
+    actionTaken: `applied source remedy for ${resolver.causeCode}; re-verification ${check.passed ? 'passed' : 'failed'}: ${check.detail}`,
+    sourceConsulted: `blocking artifact (${attempt.siteId})`,
+    reclassifyTo: check.passed ? undefined : EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+    evidence: check.detail,
+  };
+}
+
+/**
+ * 2.2 DERIVABLE_FROM_HISTORY — replay at most ONE recorded resolution for the
+ * same repeatKey. History source: mission / approval / DLQ tables.
+ */
+export interface HistoryRecord {
+  repeatKey: string;
+  terminalResolution: string;
+  succeeded: boolean;
+}
+
+export async function resolveFromHistory(
+  attempt: EscalationAttempt,
+  lookup: (repeatKey: string) => Promise<HistoryRecord | null>,
+  applyRecorded: (record: HistoryRecord, attempt: EscalationAttempt) => Promise<{ ok: boolean; detail: string }>,
+): Promise<ResolutionResult> {
+  const record = await lookup(attempt.repeatKey);
+  if (!record) {
+    return {
+      resolved: false,
+      actionTaken: 'no recorded terminal resolution for repeatKey; class not satisfied (R4)',
+      sourceConsulted: 'mission/approval/DLQ history',
+      reclassifyTo: EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+    };
+  }
+  const applied = await applyRecorded(record, attempt);
+  return {
+    resolved: applied.ok,
+    actionTaken: `replayed recorded resolution for ${attempt.repeatKey.slice(0, 12)}: ${record.terminalResolution}; outcome: ${applied.detail}`,
+    sourceConsulted: 'mission/approval/DLQ history',
+    reclassifyTo: applied.ok ? undefined : EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+    evidence: applied.detail,
+  };
+}
+
+/**
+ * 2.3 DERIVABLE_FROM_RUNTIME — read fresh live state, act, re-check (≤3).
+ * State must be read inside the attempt's execution window; cached state older
+ * than the attempt is not a source (R1/R4).
+ */
+export interface RuntimeSnapshot {
+  readAt: string;
+  [key: string]: unknown;
+}
+
+export async function resolveFromRuntime(
+  attempt: EscalationAttempt,
+  readState: () => Promise<RuntimeSnapshot>,
+  decide: (snapshot: RuntimeSnapshot, attempt: EscalationAttempt) => Promise<{ action: string; done: boolean; detail: string }>,
+): Promise<ResolutionResult> {
+  for (let i = 0; i < RESOLUTION_BOUNDS.maxRuntimeRechecks; i++) {
+    const snapshot = await readState();
+    const d = await decide(snapshot, attempt);
+    if (d.done) {
+      return {
+        resolved: true,
+        actionTaken: `runtime decision after ${i + 1} check(s): ${d.action}; ${d.detail}`,
+        sourceConsulted: `live state read at ${snapshot.readAt}`,
+        evidence: d.detail,
+      };
+    }
+  }
+  return {
+    resolved: false,
+    actionTaken: `runtime state did not yield a decision after ${RESOLUTION_BOUNDS.maxRuntimeRechecks} checks; converting to experiment (R2)`,
+    sourceConsulted: 'live scheduler/registry/queue/table state',
+    reclassifyTo: EscalationClass.SAFE_EXPERIMENT_AVAILABLE,
+  };
+}
+
+/**
+ * 2.4 SAFE_EXPERIMENT_AVAILABLE — one bounded experiment per hypothesis.
+ * The experiment MUST be: side-effect-free or fully sandboxed, time-bounded
+ * (default 5 min), evidence-recorded, reversible by construction.
+ */
+export interface SafeExperiment {
+  hypothesis: string;
+  /** Runs the dry-run; must not mutate production state. */
+  run: () => Promise<{ success: boolean; evidence: string }>;
+  timeoutMs?: number;
+}
+
+export async function trySafeExperiment(
+  attempt: EscalationAttempt,
+  experiment: SafeExperiment,
+): Promise<ResolutionResult> {
+  const timeoutMs = experiment.timeoutMs ?? RESOLUTION_BOUNDS.experimentTimeoutMs;
+  const result = await Promise.race([
+    experiment.run(),
+    new Promise<{ success: false; evidence: string }>((resolve) =>
+      setTimeout(() => resolve({ success: false, evidence: `experiment timed out after ${timeoutMs}ms` }), timeoutMs),
+    ),
+  ]);
+  return {
+    resolved: result.success,
+    actionTaken: `safe experiment for hypothesis ${JSON.stringify(experiment.hypothesis)}: ${result.success ? 'succeeded' : 'failed'}`,
+    sourceConsulted: 'sandbox experiment harness',
+    // On failure the evidence goes WITH the escalation: the human decides once (2.4).
+    reclassifyTo: result.success ? undefined : EscalationClass.OTHER,
+    evidence: result.evidence,
+  };
+}
diff --git a/src/tenanos/decision-budget/escalation-envelope.ts b/src/tenanos/decision-budget/escalation-envelope.ts
