+// Canonical tenant-slug shape (src/tenanos/tenant/tenant-context.ts,
+// P-20260923-092): the tenant identity string IS `tenant::<slug>`.
+// This bridge consumes that mapping; it does not redefine it.
+const TENANT_SLUG_RE = /^[a-z0-9-]{1,64}$/;
+const SYSTEM_NAMESPACE = 'core::system';
+
+/**
+ * Map a canonical_events tenant_id to the enforced spine namespace.
+ * Policy owner: src/tenanos/tenant/bridge-tenant.ts (namespaceForTenantId).
+ * Unknown/unmappable tenant -> system default + tenant_unknown tag so the
+ * laundering is OBSERVABLE instead of silent (worker keeps running).
+ */
+function namespaceForTenantId(tenantId) {
+  if (tenantId === null || tenantId === undefined || tenantId === '') {
+    return { namespace: SYSTEM_NAMESPACE, tenantUnknown: true };
+  }
+  const raw = String(tenantId);
+  if (NAMESPACE_RE.test(raw)) return { namespace: raw, tenantUnknown: false };
+  if (TENANT_SLUG_RE.test(raw)) return { namespace: `tenant::${raw}`, tenantUnknown: false };
+  return { namespace: SYSTEM_NAMESPACE, tenantUnknown: true };
+}
