@@ -105,6 +105,24 @@ function group(graph: ObjectGraph): Grouped {
   const services = related("service");
   const products = related("product");
   const locations = related("location");
   const people = related("person");
+  // Reverse-direction employment: website ingestion records works_for as
+  // person -> business, but related() only matches owner -> person edges
+  // (employs|has_member). Eligibility (deriveEligibility in
+  // src/fyd/builder/eligibility.ts) honors works_for in either direction;
+  // when the grouping does not, team members the eligibility report counts
+  // never reach section emission and the People section silently vanishes
+  // (observed: coppersmith-plumbing has a works_for team member,
+  // eligibility team=1, yet no People section was emitted). Merge the
+  // reverse edges here so the two modules agree on who the team is.
+  // Deterministic: dedup by id, re-sorted by id like related().
+  if (owner) {
+    const seen = new Set(people.map((p) => p.id));
+    for (const r of graph.relationships) {
+      if (r.status !== "active" || r.predicate !== "works_for" || r.object !== owner.id) continue;
+      const p = objects.get(r.subject);
+      if (p && SCHEMA_ROLES.person.includes(p.schema) && p.visibility === "public" && !seen.has(p.id)) {
+        seen.add(p.id);
+        people.push(p);
+      }
+    }
+    people.sort(byId);
+  }
   // Published content spans the post and article roles; the split reads
   // the central role map, never hardcoded schema ids.
   const published = [...related("post"), ...related("article")].sort(byId);
