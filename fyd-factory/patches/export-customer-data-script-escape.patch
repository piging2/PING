# Patch 4 (REQUIRED): exportCustomerData script-breakout hardening
#
# Finding: W3 (A49). exportCustomerData in src/fyd/boundary/data-boundary.ts
# emitted literal "<script>" substrings in the JSON blob
# (live-script-in-json=true). Safe as pure JSON; hazardous if a downstream
# consumer ever naively inlines the export into an HTML <script> block,
# where a literal "</script>" inside a string terminates the block and the
# following attacker-controlled text becomes live script.
#
# Fix: escape every "<" as \u003c after stringify. This is lossless under
# JSON.parse (the round-trip is byte-identical), kills every "</script>"
# sequence in the output, and changes no data semantics. One line, at the
# single export choke point; importCustomerData needs no change.
#
# Apply: git apply ~/workspace/fyd-factory/patches/export-customer-data-script-escape.patch
# (from repo root /home/nolan/projects/ping, branch fyd-factory)

--- a/src/fyd/boundary/data-boundary.ts
+++ b/src/fyd/boundary/data-boundary.ts
@@ -112,7 +112,12 @@
  * with no FYD internals.
  */
 export function exportCustomerData(pkg: CustomerDataPackage): string {
-  return JSON.stringify(pkg, null, 2);
+  // Script-breakout hardening: the export is portable JSON, but a naive
+  // downstream consumer may inline it into an HTML <script> block, where a
+  // literal "</script>" inside a string would terminate the block. Escaping
+  // every "<" as \u003c is lossless under JSON.parse (round-trip
+  // byte-identical) and makes breakout impossible.
+  return JSON.stringify(pkg, null, 2).replace(/</g, "\\u003c");
 }
 
