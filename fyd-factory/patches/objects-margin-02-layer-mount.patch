New file (proposal): src/app/sites/_shared/tenant-object-margin.tsx

  "use client";
  import * as React from "react";
  import { MarginObjectLayer, type MarginObjectDescriptor } from "@/fyd/ui/object-layer/MarginObjectLayer";
  import type { ObjectGraph } from "@/fyd/sitespec/types";
  import type { FYDPage } from "@/fyd/sitespec/types";

  // Build descriptors for the active page from the public graph.
  // Evidence-backed fields only; unknown fields stay null.
  export function descriptorsForPage(graph: ObjectGraph, page: FYDPage | undefined): MarginObjectDescriptor[] {
    if (!page) return [];
    const bySchema = (schemas: string[]) => graph.objects.filter((o) => schemas.includes(o.schema));
    const anchorFor = (component: string) => page.sections.find((s) => s.component === component)?.id ?? null;
    const out: MarginObjectDescriptor[] = [];
    const push = (objs: ReturnType<typeof bySchema>, component: string, priority: number) => {
      const anchorKey = anchorFor(component);
      if (!anchorKey) return;
      for (const o of objs.sort((a, b) => (a.id < b.id ? -1 : 1))) {
        out.push({
          objectId: o.id,
          name: (typeof o.title === "string" && o.title) || o.id,
          imageSrc: null,
          imageSrcSet: null,
          websiteUrl: null,
          anchorKey,
          priority,
          category: typeof o.fields?.["category"] === "string" ? o.fields["category"] : null,
          location: null, // coarse public claims only; resolved from location objects when present
          whyHere: null,
        });
      }
    };
    push(bySchema(["ping.social.service@1", "ping.knowledge.service@1"]), "Services", 10);
    push(bySchema(["ping.social.person@1", "ping.knowledge.person@1"]), "People", 20);
    push(bySchema(["ping.social.location@1", "ping.knowledge.location@1"]), "Locations", 30);
    push(bySchema(["ping.social.post@1", "ping.social.article@1"]), "ObjectFeed", 40);
    return out;
  }

  const DESKTOP_MIN = 1024;

  export function TenantObjectMargin({ graph, page }: { graph: ObjectGraph; page: FYDPage | undefined }) {
    const [wide, setWide] = React.useState(false);
    React.useEffect(() => {
      const mq = window.matchMedia(`(min-width: ${DESKTOP_MIN}px)`);
      const update = () => setWide(mq.matches);
      update();
      mq.addEventListener("change", update);
      return () => mq.removeEventListener("change", update);
    }, []);
    const objects = React.useMemo(() => descriptorsForPage(graph, page), [graph, page]);
    if (!wide || objects.length === 0) return null;
    return <MarginObjectLayer objects={objects} />;
  }

