{"$id":"https://ping.social/schemas/social-interdependence/threads/intent/v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Durable, idempotent unit of authorized autonomous work on Threads. intent_id is the cross-platform contract form: <platform>:<action>:<target_ref>:<batch_id>. target_ref uses the engagement-guard post-ID form (post:<id>).","properties":{"action":{"enum":["like","comment"]},"actor":{"type":"string"},"attempt":{"default":0,"minimum":0,"type":"integer"},"authorized_account":{"type":"string"},"batch_id":{"type":"string"},"comment_text":{"type":["string","null"]},"created_at":{"format":"date-time","type":"string"},"decision_ref":{"type":"string"},"envelope_ref":{"type":"string"},"evidence_hash":{"type":"string"},"intent_id":{"pattern":"^threads:(like|comment):post:[A-Za-z0-9_-]+:[a-z0-9-]+$","type":"string"},"max_attempts":{"default":2,"minimum":1,"type":"integer"},"platform":{"const":"threads"},"prev_hash":{"type":["string","null"]},"state":{"enum":["DISCOVERED","NORMALIZED","EVALUATED","ELIGIBLE","REJECTED","INTENT_CREATED","QUEUED","SCHEDULED","DISPATCHED","ATTEMPTING","UNKNOWN","VERIFYING","VERIFIED_SUCCESS","VERIFIED_NOOP","SAFE_RETRY","DEFERRED","FAILED_RETRYABLE","FAILED_TERMINAL","CANCELLED"]},"target_handle":{"pattern":"^@?[A-Za-z0-9_.]{1,40}$","type":"string"},"target_ref":{"pattern":"^post:[A-Za-z0-9_-]+$","type":"string"},"target_url":{"type":"string"}},"required":["intent_id","platform","action","target_ref","batch_id","actor","authorized_account","state","created_at","envelope_ref","decision_ref"],"title":"Threads social-interdependence intent","type":"object"}