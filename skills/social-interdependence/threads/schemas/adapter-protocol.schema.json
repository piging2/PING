{"$id":"https://ping.social/schemas/social-interdependence/threads/adapter-protocol/v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"The closed JSON protocol between the Threads adapter and its executor (Pig worker th-engage.js on live runs; the JS fixture at the test boundary). The adapter receives an authorized intent; it never chooses targets, sets policy, or declares canonical success.","properties":{"actions":{"items":{"properties":{"account":{"type":"string"},"marker":{"type":"string"},"text":{"type":["string","null"]},"type":{"enum":["like","comment"]},"url":{"type":"string"}},"required":["type","account","url","marker"],"type":"object"},"maxItems":60,"type":"array"},"dispatch":{"properties":{"attempt":{"minimum":1,"type":"integer"},"dispatched_at":{"format":"date-time","type":"string"},"executor":{"enum":["pig","fixture"]},"intent_id":{"type":"string"},"lease_id":{"type":"string"}},"required":["intent_id","executor","lease_id","attempt","dispatched_at"],"type":"object"},"maxDelaySec":{"maximum":300,"minimum":1,"type":"number"},"minDelaySec":{"maximum":300,"minimum":1,"type":"number"},"result":{"properties":{"actions":{"items":{"properties":{"account":{"type":"string"},"action_index":{"minimum":0,"type":"integer"},"error":{"type":["string","null"]},"external_effect":{"enum":["applied","already_present","none_observed","unknown"]},"note":{"type":"string"},"outcome":{"enum":["executed","already","failed","blocked","timeout"]},"url":{"type":"string"}},"required":["action_index","url","outcome","external_effect","note"],"type":"object"},"type":"array"},"completed_at":{"format":"date-time","type":"string"},"infra":{"type":["string","null"]},"job_id":{"type":"string"},"ok":{"type":"boolean"}},"required":["ok","job_id","actions"],"type":"object"}},"required":["actions","minDelaySec","maxDelaySec"],"title":"Threads adapter executor protocol","type":"object"}