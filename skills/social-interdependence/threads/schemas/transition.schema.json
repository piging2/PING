{"$id":"https://ping.social/schemas/social-interdependence/threads/transition/v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"One persisted state-machine transition. Transitions form a sha256 hash chain; replay reconstructs state from the chain. Replay is decision replay, never mutation replay.","properties":{"actor":{"type":"string"},"at":{"format":"date-time","type":"string"},"evidence_refs":{"items":{"type":"string"},"type":"array"},"from_state":{"type":"string"},"hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"intent_id":{"type":"string"},"note":{"type":"string"},"prev_hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"seq":{"minimum":0,"type":"integer"},"to_state":{"enum":["DISCOVERED","NORMALIZED","EVALUATED","ELIGIBLE","REJECTED","INTENT_CREATED","QUEUED","SCHEDULED","DISPATCHED","ATTEMPTING","UNKNOWN","VERIFYING","VERIFIED_SUCCESS","VERIFIED_NOOP","SAFE_RETRY","DEFERRED","FAILED_RETRYABLE","FAILED_TERMINAL","CANCELLED"]}},"required":["seq","intent_id","from_state","to_state","at","actor","evidence_refs","prev_hash","hash"],"title":"Threads intent transition","type":"object"}