{"$id":"https://ping.social/schemas/social-interdependence/threads/evidence-package/v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Canonical evidence for one intent's terminal outcome. Canonical success exists ONLY with verification; a package never declares VERIFIED_SUCCESS without a read-back observation.","properties":{"adapter_result":{"type":"object"},"at":{"format":"date-time","type":"string"},"decision_ref":{"type":"string"},"envelope_ref":{"type":"string"},"evidence_hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"external_observation":{"type":["object","null"]},"intent_id":{"type":"string"},"outcome":{"enum":["VERIFIED_SUCCESS","VERIFIED_NOOP","FAILED_RETRYABLE","FAILED_TERMINAL","CANCELLED"]},"policy_verdict":{"properties":{"decision":{"enum":["ELIGIBLE","INELIGIBLE","UNKNOWN"]},"guard_version":{"type":"string"},"primary_reason":{"type":["string","null"]}},"required":["decision","primary_reason","guard_version"],"type":"object"},"prev_hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"transition_refs":{"items":{"type":"string"},"minItems":1,"type":"array"},"verification":{"properties":{"method":{"type":"string"},"observed_state":{"type":"string"},"verified_at":{"format":"date-time","type":"string"}},"required":["method","observed_state","verified_at"],"type":"object"}},"required":["intent_id","outcome","at","decision_ref","envelope_ref","policy_verdict","adapter_result","external_observation","verification","transition_refs","evidence_hash"],"title":"Threads canonical evidence package","type":"object"}