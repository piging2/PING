{"$id":"https://ping.social/schemas/x/transition-evidence.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One persisted state transition. Hash-chained: hash = sha256(prev_hash + canonical(body)). Replay re-derives decisions; it never re-executes mutations.","properties":{"actor":{"type":"string"},"at":{"format":"date-time","type":"string"},"attempt":{"type":["integer","null"]},"evidence_refs":{"items":{"type":"string"},"type":"array"},"extra":{"type":"object"},"from_state":{"type":"string"},"hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"identity_key":{"type":["string","null"]},"intent_id":{"type":"string"},"note":{"type":"string"},"prev_hash":{"type":"string"},"seq":{"minimum":1,"type":"integer"},"terminal":{"type":["string","null"]},"to_state":{"type":"string"}},"required":["seq","at","intent_id","from_state","to_state","actor","prev_hash","hash"],"title":"X intent transition evidence","type":"object"}