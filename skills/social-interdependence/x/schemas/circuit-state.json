{"$id":"https://ping.social/schemas/x/circuit-state.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Circuit-breaker state for one scope. Reproduces the x-probe precedent: consecutive timeouts open the scope, no probe or execution while open, machine-readable reason, 6h half-open cooldown, operator-directive pin.","properties":{"consecutive_failures":{"minimum":0,"type":"integer"},"consecutive_timeouts":{"minimum":0,"type":"integer"},"failure_threshold":{"minimum":1,"type":"integer"},"half_open_at":{"type":["string","null"]},"half_open_cooldown_sec":{"minimum":60,"type":"integer"},"half_open_trial_inflight":{"type":"boolean"},"opened_at":{"type":["string","null"]},"operator_directive":{"type":["string","null"]},"reason":{"type":["string","null"]},"scope":{"type":"string"},"state":{"enum":["CLOSED","OPEN","HALF_OPEN"]},"timeout_threshold":{"minimum":1,"type":"integer"}},"required":["scope","state","consecutive_failures","consecutive_timeouts","failure_threshold","timeout_threshold","half_open_cooldown_sec"],"title":"X circuit-breaker state","type":"object"}