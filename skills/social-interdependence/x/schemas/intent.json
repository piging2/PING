{"$id":"https://ping.social/schemas/x/intent.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Durable, stable-identity record of one authorized X action. intent_id = x:<action>:<target_ref>:<batch_id>.","properties":{"action":{"enum":["like","follow","comment"]},"actor":{"minLength":1,"type":"string"},"attempt":{"minimum":0,"type":"integer"},"authorized_account":{"minLength":1,"type":"string"},"batch_id":{"minLength":1,"type":"string"},"created_at":{"format":"date-time","type":"string"},"decision_ref":{"type":"string"},"envelope_ref":{"type":"string"},"evidence_hash":{"type":["string","null"]},"handle":{"type":["string","null"]},"identity_key":{"pattern":"^x:(like|follow|comment):(post|user):.+$","type":"string"},"intent_id":{"pattern":"^x:(like|follow|comment):(post|user):[^:]+:[A-Za-z0-9_-]+$","type":"string"},"max_attempts":{"minimum":1,"type":"integer"},"platform":{"const":"x"},"prev_hash":{"type":["string","null"]},"state":{"enum":["DISCOVERED","NORMALIZED","EVALUATED","ELIGIBLE","REJECTED","INTENT_CREATED","QUEUED","SCHEDULED","DISPATCHED","ATTEMPTING","UNKNOWN","VERIFYING","VERIFIED_SUCCESS","VERIFIED_NOOP","SAFE_RETRY","DEFERRED","FAILED_RETRYABLE","FAILED_TERMINAL","CANCELLED"]},"target_ref":{"pattern":"^(post|user):.+$","type":"string"},"url":{"type":["string","null"]},"user_id":{"type":["string","null"]}},"required":["intent_id","platform","action","target_ref","identity_key","authorized_account","actor","batch_id","state","attempt","created_at"],"title":"X social-interdependence intent","type":"object"}