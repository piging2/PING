{"$id":"https://ping.social/schemas/x/watchdog-report.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Watchdog evaluation. Actions are limited to OK / REDUCE / STOP / DEFER / ROLLBACK. The watchdog may not grant authority.","properties":{"action":{"enum":["OK","REDUCE","STOP","DEFER","ROLLBACK"]},"at":{"format":"date-time","type":"string"},"duplicate_canonical_actions":{"minimum":0,"type":"integer"},"failure_rate":{"maximum":1,"minimum":0,"type":"number"},"findings":{"items":{"type":"string"},"type":"array"},"policy_violations":{"minimum":0,"type":"integer"},"unknown_rate":{"maximum":1,"minimum":0,"type":"number"},"verification_failures":{"minimum":0,"type":"integer"},"window_receipts":{"minimum":0,"type":"integer"}},"required":["at","window_receipts","failure_rate","unknown_rate","verification_failures","policy_violations","duplicate_canonical_actions","findings","action"],"title":"X watchdog report","type":"object"}