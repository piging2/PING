{"$id":"https://ping.social/schemas/facebook/autonomy_envelope.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Machine-readable authorization boundary replacing per-action human approval. Only an owner-signed update may change it; the learner, watchdog, and adapter can never write it.","properties":{"acting_account":{"description":"Facebook-specific extension: the single logged-in identity that acts. Must be in authorized_accounts.","type":"string"},"actor":{"type":"string"},"allowed_action_types":{"items":{"enum":["like","comment"]},"minItems":1,"type":"array"},"allowed_capabilities":{"items":{"type":"string"},"type":"array"},"allowed_platforms":{"const":["facebook"]},"authorized_accounts":{"items":{"type":"string"},"minItems":1,"type":"array"},"circuit_breaker_policy":{"properties":{"cooldown_sec":{"type":"integer"},"negative_feedback_threshold":{"type":"integer"},"observation_window_sec":{"type":"integer"},"scopes":{"items":{"type":"string"},"type":"array"},"verification_failure_threshold":{"type":"integer"}},"type":"object"},"concurrency_budget":{"type":"object"},"confidence_requirements":{"properties":{"min_identity_confidence":{"maximum":1,"minimum":0,"type":"number"}},"type":"object"},"execution_budget":{"properties":{"base":{"type":"object"},"ramp_anchor":{"type":"string"},"ramp_per_week":{"type":"object"},"window_sec":{"type":"integer"}},"required":["window_sec"],"type":"object"},"learner":{"description":"Bounded self-improvement. Bounds are constitutional; the learner tunes only within them.","properties":{"bounds":{"additionalProperties":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"type":"object"},"stage":{"enum":["SHADOW","CANARY","ACTIVE"]}},"type":"object"},"maximum_failure_rate":{"maximum":1,"minimum":0,"type":"number"},"maximum_unknown_rate":{"maximum":1,"minimum":0,"type":"number"},"namespace_scope":{"type":"string"},"platform_budget":{"type":"object"},"prohibited_tar