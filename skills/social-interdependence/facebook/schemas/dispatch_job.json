{"$id":"https://ping.social/schemas/facebook/dispatch_job.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Dispatch file handed toward the worker. Matches the run_pass.sh contract: a dict with actions/minDelaySec/maxDelaySec (a bare list crashes the guard). Canonical action-object key is type.","properties":{"actions":{"items":{"properties":{"eligibility":{"type":"object"},"intent_id":{"type":"string"},"text":{"type":["string","null"]},"type":{"enum":["like","comment"]},"url":{"type":"string"}},"required":["type","url","eligibility"],"type":"object"},"type":"array"},"batch_id":{"type":"string"},"maxDelaySec":{"type":"integer"},"minDelaySec":{"type":"integer"},"pass_id":{"type":"string"}},"required":["actions","minDelaySec","maxDelaySec"],"title":"Facebook dispatch job","type":"object"}