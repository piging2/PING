{"$id":"https://ping.social/schemas/facebook/decision_record.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"Per-candidate decision record. No opaque single AI score acts as authority: decision derives from policy_result, confidence_requirements, budget_result, and saturation, each recorded.","properties":{"action_candidates":{"items":{"type":"string"},"type":"array"},"actor":{"type":"string"},"budget_result":{"properties":{"admitted":{"type":"boolean"}},"required":["admitted"],"type":"object"},"candidate_id":{"type":"string"},"capabilities":{"type":"object"},"content":{"type":["string","null"]},"decision":{"enum":["proceed","drop"]},"evidence":{"description":"Human-readable evidence refs from eligibility_check (data-file citations).","items":{"type":"string"},"type":"array"},"identity_confidence":{"maximum":1,"minimum":0,"type":"number"},"materiality":{"enum":["low","medium","high"]},"outcome_history":{"type":"object"},"platform":{"const":"facebook"},"policy_result":{"properties":{"decision":{"enum":["ELIGIBLE","INELIGIBLE","UNKNOWN"]},"primary_reason":{"type":["string","null"]},"reasons":{"items":{"type":"string"},"type":"array"}},"required":["decision","reasons"],"type":"object"},"reason":{"type":"string"},"relationship":{"type":["string","null"]},"relationship_context":{"type":"object"},"saturation":{"properties":{"note":{"type":"string"},"saturated":{"type":"boolean"}},"required":["saturated","note"],"type":"object"},"target":{"type":["string","null"]},"ts":{"format":"date-time","type":"string"},"uncertainty":{"maximum":1,"minimum":0,"type":"number"}},"required":["candidate_id","actor","target","relationship","content","platform","action_candidates","identity_confidence","relationship_context","evidence","capabilities","policy_result","budget_result","materiality","uncertainty","saturation","outcome_history","decision","reason"],"title":"Facebook decision record","type":"object"}